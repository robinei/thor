#!/bin/sh
# Starts an Android app (Waydroid's, by its desktop file's name: `clamshell-android waydroid.<package>`)
# full-screen in a window of its own, as ClamShell's Android runner launches them. `waydroid app launch`
# opens apps as Android's floating windows, phone-sized in the middle of the window sway gives them; adb's
# shell starts them full-screen instead, without root.
#
# Waydroid shows no app windows until `waydroid.active_apps` names one, which only its own launch sets: a
# new session's first launch goes through it once with the launcher (which is never shown in a window).
#
# The Waydroid session and adb's server run as units of their own, not in the app's launch: quitting an
# app leaves Android running. The adb server is ClamShell's own, on a port of its own (not adb's usual
# 5037: a server someone started by hand isn't used). Without adb, Waydroid's own launch. Setup:
# docs/android.md.
#
# `clamshell-android --stop waydroid.<package>`: the app stopped (ClamShell's Force kill).
# `clamshell-android --pause`, `--resume`: Android frozen, or thawed (the container's cgroup, through
# Waydroid's container service: no root needed); ClamShell's In the background, set for the runner.
# A launch thaws it first.
# `clamshell-android --awake`: succeeds while Android keeps the screen on (an app's window asks to: a
# video playing, the camera; Android holds a screen wake lock then), which the compositor doesn't hear;
# ClamShell asks before the screens dim while an Android app is shown.
set -u
container() {
    busctl call id.waydro.Container /ContainerManager id.waydro.ContainerManager "$1" > /dev/null 2>&1
}
case "${1:-}" in
    --pause) container Freeze; exit ;;
    --resume) container Unfreeze; exit ;;
esac
stop=
if [ "${1:-}" = --stop ]; then
    stop=1
    shift
fi
pkg=${1#waydroid.}

running() { waydroid status 2> /dev/null | grep -q '^Session:[[:space:]]*RUNNING'; }
if [ "${1:-}" = --awake ]; then
    running || exit 1
    dev=$(waydroid status | sed -n 's/^IP address:[[:space:]]*//p'):5555
    ANDROID_ADB_SERVER_PORT=5039 adb -s "$dev" shell dumpsys power 2> /dev/null | grep -qE 'SCREEN_(BRIGHT|DIM)_WAKE_LOCK|FULL_WAKE_LOCK'
    exit
fi
[ -n "$stop" ] && ! running && exit 0
running && container Unfreeze
if ! running; then
    # Waydroid on ClamShell's Wayland filter (`clamshell --wayland-filter`, ClamShell's own program as its
    # launches have it: CLAMSHELL), not the compositor's socket itself: Waydroid would lose an app's window
    # whenever the compositor configures it (hidden, shown, focused); the filter keeps those configures
    # from it. (On ClamShell's display: the user manager's may be another's, a desktop's around a nested
    # session.) The session is bound to the filter, which ends when the compositor does: Waydroid can't go
    # on without its display.
    display=$WAYLAND_DISPLAY
    bound=
    filter=${CLAMSHELL:-clamshell}
    if command -v "$filter" > /dev/null; then
        systemd-run --user --quiet --collect --unit="clamshell-wayland-filter-$WAYLAND_DISPLAY" \
            -E WAYLAND_DISPLAY -E XDG_RUNTIME_DIR "$filter" --wayland-filter 2> /dev/null
        i=0
        while [ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY-android" ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
        if [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY-android" ]; then
            display=$WAYLAND_DISPLAY-android
            bound="clamshell-wayland-filter-$WAYLAND_DISPLAY.service"
        fi
    fi
    # The clipboard shared with Android through ClamShell's (a stand-in for the pyclip Waydroid imports,
    # installed beside ClamShell's data: see pyclip.py).
    systemd-run --user --quiet --collect --unit=waydroid-session ${bound:+-p BindsTo="$bound" -p After="$bound"} \
        -E WAYLAND_DISPLAY="$display" -E XDG_RUNTIME_DIR -E CLAMSHELL="$(command -v "$filter")" \
        -E PYTHONPATH="${XDG_DATA_HOME:-$HOME/.local/share}/clamshell/python" waydroid session start 2> /dev/null
    i=0
    while ! running && [ $i -lt 60 ]; do sleep 1; i=$((i + 1)); done
fi

if ! command -v adb > /dev/null; then
    [ -n "$stop" ] && exit 1
    exec waydroid app launch "$pkg"
fi
# Android's address (UNKNOWN until its network is up, some seconds into its start: read again below).
address() { dev=$(waydroid status | sed -n 's/^IP address:[[:space:]]*//p'):5555; }
address
export ANDROID_ADB_SERVER_PORT=5039
systemd-run --user --quiet --collect --unit=clamshell-adb -E ANDROID_ADB_SERVER_PORT adb -a nodaemon server 2> /dev/null
i=0
while ! ss -ltn 2> /dev/null | grep -q ":$ANDROID_ADB_SERVER_PORT " && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
android() { adb -s "$dev" shell "$@" 2> /dev/null | tr -d '\r'; }
# (Connected again until it answers: Android's network comes up some seconds into its start.)
i=0
while [ "$(android getprop sys.boot_completed)" != 1 ] && [ $i -lt 90 ]; do
    case $dev in
        [0-9]*) adb connect "$dev" > /dev/null 2>&1 ;;
        *) address ;;
    esac
    sleep 1
    i=$((i + 1))
done
if [ -n "$stop" ]; then
    android am force-stop "$pkg"
    # Its tasks too: one can outlive it with another app's activity on top (Android's permission
    # prompt), its window with it.
    for task in $(android am stack list | awk -v pkg="$pkg/" '/^RootTask id=/ { sub("id=", "", $2); root = $2 } index($2, pkg) == 1 { print root }'); do
        android am stack remove "$task"
    done
    exit
fi

# The caption's height for the Wayland filter, which puts it out of sight: 57 pixels at a density of 213
# (measured), in proportion at Android's density (an override's, if one is set).
density=$(android wm density | sed -n 's/^.* density: //p' | tail -1)
case $density in
    '' | *[!0-9]*) ;;
    *) echo $(((57 * density + 106) / 213)) > "$XDG_RUNTIME_DIR/clamshell/android-caption" ;;
esac

# No on-screen keyboard of Android's: its keyboard stays hidden beside the hardware one Android sees
# (Waydroid's Wayland keyboard, ClamShell's keys), but Waydroid still makes its window, empty, which
# took the screen and the focus as a text field got focus. Fields take keys without one.
for ime in $(android ime list -s); do
    android ime disable "$ime" > /dev/null
done

case $(android getprop waydroid.active_apps) in
    '' | none | Waydroid) waydroid app launch com.android.launcher3 ;;
esac
activity=$(android cmd package resolve-activity --brief -c android.intent.category.LAUNCHER "$pkg" | tail -1)
case $activity in
    */*) android am start --windowingMode 1 -n "$activity" > /dev/null ;;
    *) exec waydroid app launch "$pkg" ;;
esac
