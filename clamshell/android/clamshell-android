#!/bin/sh
# Starts an Android app (Waydroid's, by its desktop file's name: `clamshell-android waydroid.<package>`)
# full-screen in a window of its own, as ClamShell's Android runner launches them. `waydroid app launch`
# opens apps as Android's floating windows, phone-sized in the middle of the window sway gives them; adb's
# shell starts them full-screen instead, without root.
#
# Waydroid shows no app windows until `waydroid.active_apps` names one, which only its own launch sets: a
# new session's first launch goes through it once with the launcher (which is never shown in a window).
#
# The Waydroid session and adb's server run as units of their own, not in the app's launch: quitting an
# app leaves Android running. The adb server is ClamShell's own, on a port of its own (not adb's usual
# 5037: a server someone started by hand isn't used). Without adb, Waydroid's own launch. Setup:
# docs/android.md.
#
# `clamshell-android --stop waydroid.<package>`: the app stopped (ClamShell's Force kill).
# `clamshell-android --pause`, `--resume`: Android frozen, or thawed (the container's cgroup, through
# Waydroid's container service: no root needed); ClamShell's In the background, set for the runner.
# A launch thaws it first.
set -u
container() {
    busctl call id.waydro.Container /ContainerManager id.waydro.ContainerManager "$1" > /dev/null 2>&1
}
case "${1:-}" in
    --pause) container Freeze; exit ;;
    --resume) container Unfreeze; exit ;;
esac
stop=
if [ "${1:-}" = --stop ]; then
    stop=1
    shift
fi
pkg=${1#waydroid.}

running() { waydroid status 2> /dev/null | grep -q '^Session:[[:space:]]*RUNNING'; }
[ -n "$stop" ] && ! running && exit 0
running && container Unfreeze
if ! running; then
    # (On ClamShell's display: the user manager's may be another's, a desktop's around a nested session.)
    systemd-run --user --quiet --collect --unit=waydroid-session -E WAYLAND_DISPLAY -E XDG_RUNTIME_DIR \
        waydroid session start 2> /dev/null
    i=0
    while ! running && [ $i -lt 60 ]; do sleep 1; i=$((i + 1)); done
fi

if ! command -v adb > /dev/null; then
    [ -n "$stop" ] && exit 1
    exec waydroid app launch "$pkg"
fi
dev=$(waydroid status | sed -n 's/^IP address:[[:space:]]*//p'):5555
export ANDROID_ADB_SERVER_PORT=5039
systemd-run --user --quiet --collect --unit=clamshell-adb -E ANDROID_ADB_SERVER_PORT adb -a nodaemon server 2> /dev/null
i=0
while ! ss -ltn 2> /dev/null | grep -q ":$ANDROID_ADB_SERVER_PORT " && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
adb connect "$dev" > /dev/null 2>&1
android() { adb -s "$dev" shell "$@" 2> /dev/null | tr -d '\r'; }
i=0
while [ "$(android getprop sys.boot_completed)" != 1 ] && [ $i -lt 90 ]; do sleep 1; i=$((i + 1)); done
if [ -n "$stop" ]; then
    android am force-stop "$pkg"
    exit
fi

case $(android getprop waydroid.active_apps) in
    '' | none | Waydroid) waydroid app launch com.android.launcher3 ;;
esac
activity=$(android cmd package resolve-activity --brief -c android.intent.category.LAUNCHER "$pkg" | tail -1)
case $activity in
    */*) android am start --windowingMode 1 -n "$activity" > /dev/null ;;
    *) exec waydroid app launch "$pkg" ;;
esac
