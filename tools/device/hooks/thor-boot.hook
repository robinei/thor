# What our initramfs and the boot loader are made of: after an update, thor-boot puts them on the card
# again (installed in /etc/pacman.d/hooks by thor-image.sh).
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = systemd
Target = mkinitcpio
Target = mkinitcpio-busybox
Target = kmod
Target = util-linux
Target = zstd

[Action]
Description = Putting the Thor's initramfs and boot loader on the card again (thor-boot)...
When = PostTransaction
Exec = /usr/local/bin/thor-boot
