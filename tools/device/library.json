{
  "keys": {},
  "steam": [{ "group": "Steam" }],
  "browse": [
    { "tab": "Files", "icon": "folder", "group": "Home", "dir": "~" },
    { "tab": "Files", "group": "Root", "dir": "/" },
    { "tab": "Files", "group": "Trash", "dir": "${XDG_DATA_HOME:-~/.local/share}/Trash/files", "trash": true }
  ],
  "removable": [{ "tab": "Files", "group": "{label}" }],
  "desktop": [
    { "id": "steam", "tab": "Apps" },
    { "id": "net.lutris.*", "tab": "Apps" },
    { "id": "*heroicgameslauncher*", "tab": "Apps" }
  ],
  "sources": [
    { "tab": "Games", "icon": "gamepad", "group": "NES", "id": "nes", "dir": "~/Games/nes", "match": ["*.nes", "*.zip"],
      "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/nestopia_libretro.so", "{path}"],
      "metadata": "libretro:Nintendo - Nintendo Entertainment System" },
    { "tab": "Games", "group": "SNES", "id": "snes", "dir": "~/Games/snes", "match": ["*.sfc", "*.smc", "*.zip"],
      "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/snes9x_libretro.so", "{path}"],
      "metadata": "libretro:Nintendo - Super Nintendo Entertainment System" },
    { "tab": "Games", "group": "Nintendo 64", "id": "n64", "dir": "~/Games/n64", "match": ["*.z64", "*.n64", "*.v64", "*.zip"],
      "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/mupen64plus_next_libretro.so", "{path}"],
      "metadata": "libretro:Nintendo - Nintendo 64" },
    { "tab": "Games", "group": "Game Boy", "id": "gb", "dir": "~/Games/gb", "match": ["*.gb", "*.gbc", "*.zip"],
      "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/gambatte_libretro.so", "{path}"],
      "metadata": "libretro:Nintendo - Game Boy Color" },
    { "tab": "Games", "group": "Game Boy Advance", "id": "gba", "dir": "~/Games/gba", "match": ["*.gba", "*.zip"],
      "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/mgba_libretro.so", "{path}"],
      "metadata": "libretro:Nintendo - Game Boy Advance" },
    { "tab": "Games", "group": "Nintendo DS", "id": "nds", "dir": "~/Games/nds", "match": ["*.nds", "*.zip"],
      "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/melonds_libretro.so", "{path}"],
      "metadata": "libretro:Nintendo - Nintendo DS" },
    { "tab": "Games", "group": "Mega Drive", "id": "md", "dir": "~/Games/md", "match": ["*.md", "*.gen", "*.bin", "*.zip"],
      "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/genesis_plus_gx_libretro.so", "{path}"],
      "metadata": "libretro:Sega - Mega Drive - Genesis" },
    { "tab": "Games", "group": "PlayStation", "id": "psx", "dir": "~/Games/psx", "match": ["*.m3u", "*.chd", "*.cue", "*/*.m3u", "*/*.chd", "*/*.cue"],
      "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/pcsx_rearmed_libretro.so", "{path}"],
      "metadata": "libretro:Sony - PlayStation" },
    { "tab": "Games", "group": "Dreamcast", "id": "dc", "dir": "~/Games/dc", "match": ["*.chd", "*.gdi", "*.cdi", "*/*.gdi"],
      "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/flycast_libretro.so", "{path}"],
      "metadata": "libretro:Sega - Dreamcast" },
    { "tab": "Films", "icon": "film", "id": "films", "dir": "~/Videos/Films", "match": ["*.mkv", "*.mp4", "*.avi", "*.webm", "*/*.mkv", "*/*.mp4", "*/*.avi", "*/*.webm"],
      "launch": ["mpv", "--fs", "--save-position-on-quit", "--input-gamepad=yes", "{path}"],
      "metadata": "tmdb:movie" },
    { "tab": "TV", "icon": "tv", "id": "tv", "dir": "~/Videos/TV", "match": ["*/"], "items": ["*.mkv", "*.mp4", "*.avi", "*.webm"],
      "launch": ["mpv", "--fs", "--save-position-on-quit", "--input-gamepad=yes", "{path}"],
      "metadata": "tmdb:tv" }
  ]
}
