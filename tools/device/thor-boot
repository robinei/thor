#!/bin/bash
# Installed as /usr/local/bin/thor-boot (thor-image.sh); run as root. pacman runs it after updates of what
# the initramfs or the boot loader is made of (hooks/thor-boot.hook); the first boot runs it after putting
# the swap file's place on the command line; maintenance runs it after anything else that needs it.
#
# Rebuilds our initramfs for ROCKNIX's kernel (/etc/mkinitcpio-thor.conf) and puts it on the root's card's
# FAT partition, with the command line in force (the loader entry's options line), both ways the card
# boots: as files for systemd-boot (which it updates too), and in /KERNEL for ROCKNIX's ABL, repacked
# (checked before it replaces the old one).
set -euo pipefail
# ROCKNIX's kernel: the only one there is (the image installs no Arch kernel package).
kver=$(ls /usr/lib/modules)
[ "$(echo "$kver" | wc -l)" = 1 ] || { echo "thor-boot: expected one kernel in /usr/lib/modules, found: $kver"; exit 1; }
echo "thor-boot: initramfs for $kver"
mkinitcpio -k "$kver" -c /etc/mkinitcpio-thor.conf -g /boot/initramfs-thor.img > /var/log/thor-mkinitcpio.log 2>&1 \
    || { tail -20 /var/log/thor-mkinitcpio.log; exit 1; }

# The FAT partition: the first on the card the root is on (another disk may have ROCKNIX's too).
part=$(findmnt -nvo SOURCE /)
disk=/dev/$(lsblk -ndo PKNAME "$part")
case $disk in *[0-9]) esp=${disk}p1 ;; *) esp=${disk}1 ;; esac
mnt=/run/thor-esp
mkdir -p "$mnt"
mountpoint -q "$mnt" || mount "$esp" "$mnt"
trap 'umount "$mnt"' EXIT

cmdline=$(sed -n 's/^options //p' "$mnt/loader/entries/thor.conf")
[ -n "$cmdline" ] || { echo "thor-boot: no options line in the loader entry"; exit 1; }
cp /boot/initramfs-thor.img "$mnt/initramfs-thor.img"
cp /usr/lib/systemd/boot/efi/systemd-bootaa64.efi "$mnt/EFI/BOOT/BOOTAA64.EFI"
python3 /usr/local/lib/thor/bootimg.py repack "$mnt/KERNEL" --ramdisk "$mnt/initramfs-thor.img" --cmdline "$cmdline" -o "$mnt/KERNEL.new"
python3 /usr/local/lib/thor/bootimg.py info "$mnt/KERNEL.new" > /dev/null
mv "$mnt/KERNEL.new" "$mnt/KERNEL"
sync
echo "thor-boot: done (command line: $cmdline)"
