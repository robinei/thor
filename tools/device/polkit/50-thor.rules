// The session's user (thor) sets the time zone from ClamShell's time tab without a password prompt (there
// is no polkit agent to ask). Installed in /etc/polkit-1/rules.d by thor-image.sh, and in the VM.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.timedate1.set-timezone" && subject.user == "thor") {
        return polkit.Result.YES;
    }
});
