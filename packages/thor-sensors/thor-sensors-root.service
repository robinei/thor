[Unit]
Description=Motion sensors: the ADSP root process's files (hexagonrpcd, RootPD)
After=thor-sensors.service
BindsTo=thor-sensors.service

[Service]
# (Both share one FastRPC node; the sensors process attaches first.)
ExecStartPre=/bin/sleep 1
ExecStart=/usr/lib/thor/sensors/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -R /var/lib/thor-sensors/root
Restart=always
RestartSec=1
# hexagonrpcd serves files to the ADSP, and with PB-OS's patches writes them: it may write only its
# state folder, read the system but not the home, and gain no privilege by what it runs. (Not yet: its
# own user, PrivateNetwork, DeviceAllow, address families: each needs the device, to see that the
# sensors still come up.)
ProtectSystem=strict
ReadWritePaths=/var/lib/thor-sensors
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
