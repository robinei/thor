# The motion sensors' services on the Thor: hexagonrpcd serves the ADSP's sensors process (and its root
# process) the files it reads through FastRPC (the sensor configuration, its registry, socinfo, AYN's DSP
# library: thor-sensors, the setup), and sscregistrygen makes the registry once from the configuration.
# linux-msm's hexagonrpc at a pinned commit with PB-OS's patches (github.com/project-barry/pb-os,
# external-and-mods/pbos-motion/hexagonrpc; from suckbluefrog's Batocera builds), built static. The
# sensor hub this brings up gives ClamShell the gyro (its pad::sensor_hub); linux-thor has the kernel's
# side (FastRPC's sensors routing, the device tree), thor-firmware the configuration (AYN's and
# Qualcomm's). Tested on a Thor by PB-OS (its commit faff51e).
pkgname=thor-sensors
_hexagonrpc=dd9ac70c026e1bad93e8cffa3801255b8ceb551e
pkgver=0.4.0
pkgrel=1
pkgdesc="The AYN Thor's motion sensors' services (hexagonrpcd, with PB-OS's patches)"
arch=(aarch64)
url=https://github.com/linux-msm/hexagonrpc
license=(GPL-3.0-or-later)
depends=(glibc json-c)
makedepends=(meson ninja)
optdepends=('thor-firmware: the sensor configuration (without it the services stay off)')
install=thor-sensors.install
source=("hexagonrpc-$_hexagonrpc.tar.gz::https://github.com/linux-msm/hexagonrpc/archive/$_hexagonrpc.tar.gz"
        thor-sensors
        thor-sensors.service
        thor-sensors-root.service
        pbos-0001-sscregistrygen-ignore-non-json-inputs.patch
        pbos-0002-hexagonrpcd-add-sns-registry-reverse-interface.patch
        pbos-0003-hexagonrpcd-keep-listener-registration-open.patch
        pbos-0004-hexagonrpcd-add-static-pd-option.patch
        pbos-0005-hexagonrpcd-add-writable-hexagonfs.patch
        pbos-0006-hexagonrpcd-support-writable-sensor-registry.patch
        pbos-0007-hexagonrpcd-support-large-and-extended-callbacks.patch
        pbos-0008-hexagonrpcd-enumerate-virtual-directories.patch)
sha256sums=(575bf34b8e2a51f851b078cc4b87db3c9bb121ce5849be765352b016756d63eb
            a17a38b5a876caa714d9a082341d0d5c46c15eb98548d5dd782bb81ba70b973c
