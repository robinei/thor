prepare() {
    cd "hexagonrpc-$_hexagonrpc"
    local p
    for p in "$srcdir"/pbos-*.patch; do
        patch -p1 -F0 -s --no-backup-if-mismatch < "$p"
    done
    # (libhexagonrpc built into hexagonrpcd, PB-OS's way: a library() follows --default-library.)
    sed -i "s/^libhexagonrpc = shared_library(/libhexagonrpc = library(/" libhexagonrpc/meson.build
    grep -q "^libhexagonrpc = library(" libhexagonrpc/meson.build
}

build() {
    local cross=()
    # (Cross-compiled on the PC: tools/repo/build.sh's compiler and sysroot.)
    if [ -n "${THOR_CROSS_CC:-}" ]; then
        printf '%s\n' '[binaries]' "c = '$THOR_CROSS_CC'" "ar = 'llvm-ar'" "strip = 'llvm-strip'" \
            "pkg-config = 'pkg-config'" '[host_machine]' "system = 'linux'" "cpu_family = 'aarch64'" \
            "cpu = 'aarch64'" "endian = 'little'" > cross.ini
        cross=(--cross-file cross.ini)
    fi
    meson setup --buildtype=release --default-library=static -Dhexagonrpcd_verbose=false "${cross[@]}" \
        build "hexagonrpc-$_hexagonrpc"
    ninja -C build hexagonrpcd/hexagonrpcd tools/sscregistrygen
}

package() {
    install -Dm755 -t "$pkgdir/usr/lib/thor/sensors" build/hexagonrpcd/hexagonrpcd build/tools/sscregistrygen
    install -Dm755 thor-sensors "$pkgdir/usr/lib/thor/thor-sensors"
    install -Dm644 -t "$pkgdir/usr/lib/systemd/system" thor-sensors.service thor-sensors-root.service
    install -Dm644 "hexagonrpc-$_hexagonrpc/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
