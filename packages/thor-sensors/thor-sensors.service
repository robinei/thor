[Unit]
Description=Motion sensors: the ADSP sensors process's files (hexagonrpcd, SensorsPD)
# Only on the Thor, with the configuration (thor-firmware). (The ADSP's FastRPC node comes once the ADSP
# is up, after boot has gone on: the setup waits for it, so a restart retries rather than skips.)
ConditionFirmware=device-tree-compatible(ayn,thor)
ConditionPathExists=/usr/share/thor/sensors/config
After=sound.target systemd-udevd.service
Wants=thor-sensors-root.service

[Service]
ExecStartPre=/usr/lib/thor/thor-sensors
ExecStart=/usr/lib/thor/sensors/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -s -R /var/lib/thor-sensors/root
# (Its FastRPC node goes away for a moment while the ADSP restarts.)
Restart=always
RestartSec=1
# hexagonrpcd serves files to the ADSP, and with PB-OS's patches writes them: it may write only its
# state folder, read the system but not the home, and gain no privilege by what it runs. (Not yet: its
# own user, PrivateNetwork, DeviceAllow, address families: each needs the device, to see that the
# sensors still come up.)
ProtectSystem=strict
# (Made by systemd, writable under ProtectSystem=strict.)
StateDirectory=thor-sensors
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
