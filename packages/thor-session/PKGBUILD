# The AYN Thor's session around ClamShell (root/, as installed): the first console's autologin into
# ClamShell's compositor as a user service (thor-session, clamshell.service), udiskie as a user service of
# the session, the home's starting files where missing (thor-home: the starter library, the dock's pins,
# mpv's and RetroArch's configs), foot's config, the desktop portals' choice (GTK's), Steam's starter and
# setup, the Maintenance app. Built from the checkout this PKGBUILD is in.
pkgname=thor-session
pkgver=r570.5759033
pkgrel=1
pkgdesc="The AYN Thor's session: autologin into ClamShell, its configs, Steam's starter"
arch=(any)
url=https://github.com/robinei/thor
license=('MIT OR Apache-2.0')
# Everything the session and ClamShell use (ClamShell's own list of programs: crates/system's
# library::NEEDED): the network, Bluetooth and the battery (NetworkManager, BlueZ, UPower), sound
# (PipeWire, ALSA's default device through it too), X programs (Xwayland), removable storage (udisks2, udiskie; exFAT's tools), archives browsed
# (ratarmount), opening files (xdg-utils, imv, zathura); the starter library's players
# (RetroArch with its cores and XMB's assets, mpv; ffmpeg's ffprobe for videos' lengths).
depends=(clamshell thor-system dbus xdg-desktop-portal-gtk foot udiskie xorg-xwayland mesa noto-fonts python python-pillow curl unzip
         networkmanager bluez upower pipewire pipewire-alsa pipewire-pulse wireplumber udisks2 exfatprogs ratarmount xdg-utils
         imv zathura zathura-pdf-mupdf mpv ffmpeg
         retroarch retroarch-assets-xmb retroarch-assets-glui retroarch-assets-ozone libretro-core-info
         libretro-nestopia libretro-snes9x libretro-mupen64plus-next libretro-gambatte libretro-mgba libretro-melonds
         libretro-genesis-plus-gx libretro-beetle-psx-hw libretro-flycast)
makedepends=(git)
install=thor-session.install

# The checkout: the one this PKGBUILD is in, or THOR_REPO (a build from a copy of packages/).
_repo() { realpath "${THOR_REPO:-$startdir/../..}"; }

# (safe.directory: the checkout may be another user's, as through the build machine's share.)
_git() { git -c safe.directory="$(_repo)" -C "$(_repo)" "$@"; }

pkgver() {
    printf 'r%s.%s' "$(_git rev-list --count HEAD)" "$(_git rev-parse --short=7 HEAD)"
}

package() {
    local repo share=$pkgdir/usr/share/thor
    repo=$(_repo)
    # (Owned by root in the package, not by whoever checked it out.)
    cp -a --no-preserve=ownership "$startdir/root/." "$pkgdir/"
    # The maintenance pass's playbook (Claude Code's /maintain, in thor-maintain's folder).
    install -Dm644 "$repo/.claude/commands/maintain.md" "$share/maintenance/.claude/commands/maintain.md"
    # (Ours: MIT or Apache-2.0, either.)
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$repo/LICENSE-MIT" "$repo/LICENSE-APACHE"
}
