#!/bin/sh
# The session on the first console, as the login's profile starts it: ClamShell's compositor on the
# screens, as the user service clamshell.service (`clamshell --drm`, its log in the journal as the unit's),
# with this login's environment. Unless it can't go on, then the console stays, saying why:
#
# - the session failed: it ended 3 times within 2 minutes, so it isn't started again (a reboot starts the
#   count anew, as does waiting 2 minutes);
# - ClamShell failed: systemd gave up restarting it (failing 4 times within a minute).
#
# Exit status: 0 once a session ran and ended (the profile logs out: the console's autologin starts a
# new one), 1 when the console is to stay (said why).
set -u
state="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/clamshell"
mkdir -p "$state"

help() {
    echo
    echo "Hold the power button to turn off; turned on, it tries again. With a keyboard: exit tries again."
    echo "The whole journal: journalctl --user -b. ssh, if Remote login is on, works as ever."
}

# The session's starts in the last 2 minutes, this one's included.
now=$(date +%s)
recent=$({ cat "$state/session-starts" 2> /dev/null; echo "$now"; } | awk -v now="$now" 'now - $1 < 120')
printf '%s\n' "$recent" > "$state/session-starts"
if [ "$(printf '%s\n' "$recent" | wc -l)" -gt 3 ]; then
    echo "The session ended 3 times within 2 minutes: not started again. Its last words:"
    journalctl --user -n 15 -o cat --no-pager -u clamshell.service
    help
    exit 1
fi

# The home's starting files where missing, and the session's own configs before the system's (foot's:
# /usr/share/thor/xdg; the user's in ~/.config come first still).
[ ! -x /usr/lib/thor/thor-home ] || /usr/lib/thor/thor-home
export XDG_CONFIG_DIRS=/usr/share/thor/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}
# The desktop's name, by which xdg-desktop-portal picks its portals (clamshell-portals.conf) and apps
# know where they run.
export XDG_CURRENT_DESKTOP=ClamShell XDG_SESSION_DESKTOP=ClamShell
# This login's environment for the user manager and the bus, which ClamShell and what it starts get (less
# the shell's own variables).
env -u PWD -u OLDPWD -u SHLVL -u _ dbus-update-activation-environment --systemd --all
# Until ClamShell ends, or systemd stops restarting it (its failures counted from this session's start).
# The wait returns too when ClamShell is to run again: restarted by systemd after a failure, or by hand.
state() { systemctl --user show --property=ActiveState --value clamshell.service; }
ended() { [ -z "$(systemctl --user show --property=Job --value clamshell.service)" ] && case $(state) in inactive | failed) true ;; *) false ;; esac; }
systemctl --user reset-failed clamshell.service 2> /dev/null
while :; do
    systemctl --user start --wait clamshell.service 2> /dev/null
    ended && break
done
# The session's displays out of the environment, and what it launched and mounted stopped.
systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY
# (Quietly: a slice nothing ever ran in isn't there to stop.)
systemctl --user stop app-graphical.slice background-graphical.slice 2> /dev/null
if [ "$(state)" = failed ]; then
    echo "ClamShell failed again and again, and systemd stopped restarting it ($(date '+%H:%M:%S')). Its last words:"
    journalctl --user -u clamshell.service -n 15 -o cat --no-pager
    help
    exit 1
fi
exit 0
