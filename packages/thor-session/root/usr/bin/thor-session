#!/bin/sh
# The session on the first console, as the login's profile starts it (once `uwsm check may-start`, which
# looks at the login shell itself, says it may): through uwsm, ClamShell's compositor on the screens
# (`clamshell --drm`, its log in the journal as uwsm's unit, `wayland-wm@clamshell.service`;
# CLAMSHELL_BIN: another build of it, as the test machine's). Unless it can't go on: when it ended 3 times
# within 2 minutes (ClamShell or uwsm dying as they start), it isn't started again (a reboot starts the
# count anew, as does waiting 2 minutes), and the console stays, saying why.
#
# Exit status: 0 once a session ran and ended (the profile logs out: the console's autologin starts a
# new one), 1 when the console is to stay (said why).
set -u
state="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/clamshell"
mkdir -p "$state"

help() {
    echo
    echo "Hold the power button to turn off; turned on, it tries again. With a keyboard: exit tries again."
    echo "The whole journal: journalctl --user -b. ssh, if Remote login is on, works as ever."
}

# The session's starts in the last 2 minutes, this one's included.
now=$(date +%s)
recent=$({ cat "$state/session-starts" 2> /dev/null; echo "$now"; } | awk -v now="$now" 'now - $1 < 120')
printf '%s\n' "$recent" > "$state/session-starts"
if [ "$(printf '%s\n' "$recent" | wc -l)" -gt 3 ]; then
    echo "The session ended 3 times within 2 minutes: not started again. Its last words:"
    journalctl --user -n 15 -o cat --no-pager -u 'wayland-wm@*' -u 'wayland-wm-env@*' -t clamshell
    help
    exit 1
fi

# The home's starting files where missing, and the session's own configs before the system's (foot's:
# /usr/share/thor/xdg; the user's in ~/.config come first still).
[ ! -x /usr/lib/thor/thor-home ] || /usr/lib/thor/thor-home
export XDG_CONFIG_DIRS=/usr/share/thor/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}
# uwsm's main unit: ClamShell finalizes it once it listens, which starts the session's services (udiskie).
uwsm start -- "${CLAMSHELL_BIN:-/usr/bin/clamshell}" --drm
exit 0
