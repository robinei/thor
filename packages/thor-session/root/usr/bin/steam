#!/bin/bash
# Starts Steam, Valve's native ARM64 client in ~/.local/share/Steam (steam-setup), as /usr/bin/steam: what
# ClamShell's Steam launches (`steam -gamepadui -silent -applaunch ID`), the desktop file and steam:// links run.
# Not set up yet: set up first, in a terminal that closes once setup is done (or, on a failure, once the
# user has read why); then Steam starts here, on its own. Set up: no terminal. As Armada's launch-steam:
# the client's own folder and the links to older libraries first in the library path, Valve's runtime's
# tools on the path, and both kept for compatibility tools (Steam restores SYSTEM_PATH and
# SYSTEM_LD_LIBRARY_PATH for them).
set -u
ROOT=$HOME/.local/share/Steam
if [ ! -x "$ROOT/steamrtarm64/steam" ]; then
    foot --title "Steam setup" bash -c 'steam-setup || { read -rp "Steam setup failed. Press Enter to close " _; exit 1; }' \
        || { echo "steam: setup didn't finish (its terminal exited $?)" >&2; exit 1; }
    [ -x "$ROOT/steamrtarm64/steam" ] || { echo "steam: setup ended without the client installed" >&2; exit 1; }
fi
steam-setup --links
# (Steam's icon, for a setup from before steam-setup fetched it: behind Steam, which needn't wait for it.)
if [ ! -f "${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/256x256/apps/steam.png" ]; then
    { steam-setup --icons > /dev/null || echo "steam: Steam's icon not installed (tried again at the next start)" >&2; } &
fi
export LD_LIBRARY_PATH="$ROOT/steamrtarm64:$ROOT/lib/aarch64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
[ ! -d "$ROOT/steam-runtime-steamrt-arm64/bin" ] || export PATH="$ROOT/steam-runtime-steamrt-arm64/bin:$PATH"
export SYSTEM_PATH=$PATH SYSTEM_LD_LIBRARY_PATH=$LD_LIBRARY_PATH
cd "$ROOT/steamrtarm64" || exit 1
# (As Thorch starts it: the client's files neither checked nor repaired against a bootstrap it didn't
# install, nor updated; steam-setup --update updates it.)
exec ./steam -noverifyfiles -nobootstrapupdate -skipinitialbootstrap -norepairfiles "$@"
