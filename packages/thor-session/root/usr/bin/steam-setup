#!/bin/bash
# Steam on the Thor: Valve's native ARM64 client (unsupported by Valve, but what Armada, Thorch and ROCKNIX
# run), into ~/.local/share/Steam, as the user. Windows games run through Valve's ARM64 Proton (Wine as
# ARM64EC with FEX inside), which Steam fetches itself; x86 Linux games would need FEX on the system
# (not here). Done as Thorch's thorch-setup-steam-arm64 does it for Arch Linux ARM: Valve's runtime for
# the client (steamrt3c, arm64) and the client's binaries (its linuxarm64 manifest's
# bins_linuxarm64_linuxarm64), each checked against Valve's checksum; then the links Steam expects in
# ~/.steam, and links to the older libraries the client wants that Arch Linux ARM has newer versions of
# or none (from Valve's runtime: gtk2, ibus; from the client: libvpx 6); then a first run that fetches
# the rest of the client and exits. /usr/bin/steam starts it, and runs this on the first start.
#
#   steam-setup             install what is missing (and the links)
#   steam-setup --links     the links only (each start: Steam's updates may remove them)
#   steam-setup --update    the client's own update, run and exited (maintenance)
#
# Environment: STEAM_BRANCH (default publicbeta, as Thorch and Armada; Valve's stable linuxarm64
# manifest exists too).
set -euo pipefail
BRANCH=${STEAM_BRANCH:-publicbeta}
ROOT=$HOME/.local/share/Steam
CDN=https://client-update.steamstatic.com
RUNTIME=https://repo.steampowered.com/steamrt3c/images

# Replaces a link (never a real file or directory).
link() {  # TARGET LINK
    [ -L "$2" ] || [ ! -e "$2" ] || return 0
    ln -sfn "$1" "$2"
}

# A link to the first of the targets that exists.
first_link() {  # LINK TARGET...
    local to=$1 target
    shift
    for target in "$@"; do
        [ ! -e "$target" ] || { link "$target" "$to"; return 0; }
    done
}

links() {
    mkdir -p "$HOME/.steam" "$ROOT/lib/aarch64-linux-gnu"
    link "$ROOT" "$HOME/.steam/steam"
    link "$ROOT" "$HOME/.steam/root"
    link "$ROOT/steamrtarm64" "$HOME/.steam/sdkarm64"
    link "$ROOT/steamrtarm64" "$HOME/.steam/steamrtarm64"
    # (Steam's own update removes the launch wrapper's link, after which every Proton launch exits with
    # 127: Thorch's thorch-repair-steam-arm64. The steamclient.so links for games' Steamworks, from the
    # first place that has one, as Thorch does.)
    [ ! -x "$ROOT/linuxarm64/steam-launch-wrapper" ] \
        || link ../linuxarm64/steam-launch-wrapper "$ROOT/steamrtarm64/steam-launch-wrapper"
    mkdir -p "$HOME/.steam/sdk64" "$HOME/.steam/sdk32"
    first_link "$HOME/.steam/sdk64/steamclient.so" "$ROOT/linux64/steamclient.so" "$ROOT/steamrt64/steamclient.so"
    first_link "$HOME/.steam/sdk32/steamclient.so" "$ROOT/linux32/steamclient.so" "$ROOT/steamrt32/steamclient.so" \
        "$ROOT/ubuntu12_32/steamclient.so"
    local runtime lib target
    runtime=$(find "$ROOT/steam-runtime-steamrt-arm64" -path '*/files/lib/aarch64-linux-gnu' -type d -print -quit 2> /dev/null || true)
    for lib in libibus-1.0.so.5 libgtk-x11-2.0.so.0 libgdk-x11-2.0.so.0; do
        target=$([ -n "$runtime" ] && find "$runtime" -maxdepth 1 -name "$lib*" -print -quit)
        [ -z "$target" ] || link "$target" "$ROOT/lib/aarch64-linux-gnu/$lib"
    done
    [ ! -e "$ROOT/steamrtarm64/libvpx.so.6" ] || link "$ROOT/steamrtarm64/libvpx.so.6" "$ROOT/lib/aarch64-linux-gnu/libvpx.so.6"
}

# A download checked against its SHA-256.
download() {  # URL FILE SHA256
    [ -n "$3" ] || { echo "no checksum for $1"; exit 1; }
    curl -fL --retry 5 -o "$2.part" "$1"
    echo "$3  $2.part" | sha256sum -c --status || { echo "checksum mismatch: $1"; rm -f "$2.part"; exit 1; }
    mv "$2.part" "$2"
}

# The client run until it has updated itself, then exited (steam starts it without its updates).
update() {
    cd "$ROOT/steamrtarm64"
    LD_LIBRARY_PATH="$ROOT/steamrtarm64:$ROOT/lib/aarch64-linux-gnu" ./steam -exitsteam || true
}

case ${1:-} in
    --links) links; exit 0 ;;
    --update) links; update; links; exit 0 ;;
    "") ;;
    *) echo "usage: steam-setup [--links | --update]"; exit 2 ;;
esac

[ "$(id -u)" != 0 ] || { echo "run it as the user: Steam goes into their home"; exit 1; }
for tool in curl unzip tar sha256sum; do
    command -v "$tool" > /dev/null || { echo "missing: $tool"; exit 1; }
done
mkdir -p "$ROOT/package"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

if [ ! -d "$ROOT/steam-runtime-steamrt-arm64" ]; then
    version=$(curl -fsSL "$RUNTIME/latest-public-beta/VERSION.txt")
    echo "== Valve's runtime for the client, $version"
    sum=$(curl -fsSL "$RUNTIME/$version/SHA256SUMS" | awk '$2 == "*steam-runtime-steamrt-arm64.tar.xz" { print $1 }')
    download "$RUNTIME/$version/steam-runtime-steamrt-arm64.tar.xz" "$TMP/runtime.tar.xz" "$sum"
    tar -xJf "$TMP/runtime.tar.xz" -C "$ROOT"
fi

if [ ! -x "$ROOT/steamrtarm64/steam" ]; then
    manifest=$(curl -fsSL "$CDN/steam_client_${BRANCH}_linuxarm64")
    # (The block of bins_linuxarm64_linuxarm64: its "file", then its "sha2".)
    read -r file sum < <(awk '/"bins_linuxarm64_linuxarm64"/ { f = 1 } f && $1 == "\"file\"" { gsub(/"/, "", $2); name = $2 }
                              f && $1 == "\"sha2\"" { gsub(/"/, "", $2); print name, $2; exit }' <<< "$manifest")
    echo "== the client ($BRANCH, version $(awk -F'"' '$2 == "version" { print $4; exit }' <<< "$manifest")): $file"
    download "$CDN/$file" "$TMP/client.zip" "$sum"
    unzip -q -o "$TMP/client.zip" -d "$ROOT"
    # (A few of the zip's entries, links and a folder, are named with backslashes, Windows' separators:
    # put them where they belong.)
    for path in "$ROOT"/*\\*; do
        [ -e "$path" ] || [ -L "$path" ] || continue
        to=$ROOT/$(basename "$path" | tr '\\' /)
        mkdir -p "$(dirname "$to")"
        if [ -d "$path" ] && [ ! -L "$path" ]; then mkdir -p "$to" && rmdir "$path"; else mv -f "$path" "$to"; fi
    done
    # (Its files come world-writable.)
    chmod -R go-w "$ROOT"
    chmod +x "$ROOT/steamrtarm64/steam"
    # (The client's channel: the manifest it updates from; a mismatch makes it exit, 42.)
    echo "$BRANCH" > "$ROOT/package/beta"
    links
    echo "== the client's first run: it fetches the rest of itself, then exits"
    update
fi
links
# Libraries the client still can't find (named, so the list above can grow).
missing=$(LD_LIBRARY_PATH="$ROOT/steamrtarm64:$ROOT/lib/aarch64-linux-gnu" ldd "$ROOT/steamrtarm64/steamui.so" 2> /dev/null | awk '/not found/ { print $1 }' || true)
[ -z "$missing" ] || { echo "the client lacks:"; echo "$missing"; }
echo "== Steam is set up: steam starts it"
