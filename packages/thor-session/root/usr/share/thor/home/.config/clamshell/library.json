    { "id": "tv", "name": "TV", "icon": "tv" },
    { "id": "files", "name": "Files", "icon": "folder" },
    { "id": "apps", "name": "Apps", "icon": "apps", "recent": false },
    { "id": "tools", "name": "Tools", "type": "tools", "icon": "tools" },
    { "id": "nes", "name": "NES", "in": "games" },
    { "id": "snes", "name": "SNES", "in": "games" },
    { "id": "n64", "name": "Nintendo 64", "in": "games" },
    { "id": "gb", "name": "Game Boy", "in": "games" },
    { "id": "gba", "name": "Game Boy Advance", "in": "games" },
    { "id": "nds", "name": "Nintendo DS", "in": "games" },
    { "id": "md", "name": "Mega Drive", "in": "games" },
    { "id": "psx", "name": "PlayStation", "in": "games" },
    { "id": "dc", "name": "Dreamcast", "in": "games" },
    { "id": "steam", "name": "Steam", "in": "games" }
  ],
  "runners": [
    { "type": "desktop", "id": "desktop", "name": "Desktop", "match": ["*.desktop"] },
    { "type": "desktop", "id": "android", "name": "Android", "launch": ["clamshell-android", "{id}"], "handover": true, "stop": ["clamshell-android", "--stop", "{id}"], "pause": ["clamshell-android", "--pause"], "resume": ["clamshell-android", "--resume"], "awake": ["clamshell-android", "--awake"] },
    { "type": "steam", "id": "steam", "name": "Steam" },
    { "id": "nes", "name": "NES", "match": ["*.nes"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/nestopia_libretro.so", "{path}"] },
    { "id": "snes", "name": "SNES", "match": ["*.sfc", "*.smc"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/snes9x_libretro.so", "{path}"] },
    { "id": "n64", "name": "Nintendo 64", "match": ["*.z64", "*.n64", "*.v64"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/mupen64plus_next_libretro.so", "{path}"] },
    { "id": "gb", "name": "Game Boy", "match": ["*.gb", "*.gbc"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/gambatte_libretro.so", "{path}"] },
    { "id": "gba", "name": "Game Boy Advance", "match": ["*.gba"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/mgba_libretro.so", "{path}"] },
    { "id": "nds", "name": "Nintendo DS", "match": ["*.nds"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/melonds_libretro.so", "{path}"] },
    { "id": "md", "name": "Mega Drive", "match": ["*.md", "*.gen", "*.smd"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/genesis_plus_gx_libretro.so", "{path}"] },
    { "id": "psx", "name": "PlayStation", "match": ["*.cue", "*.chd", "*.m3u", "*.pbp"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/mednafen_psx_hw_libretro.so", "{path}"] },
    { "id": "dc", "name": "Dreamcast", "match": ["*.gdi", "*.cdi"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/flycast_libretro.so", "{path}"] },
    { "id": "video", "name": "Video", "match": ["*.mkv", "*.mp4", "*.m4v", "*.avi", "*.webm", "*.mov", "*.mpg", "*.mpeg", "*.ts", "*.wmv", "*.flv"], "launch": ["mpv", "--input-ipc-server={socket}", "{paths}"], "enqueue": "{\"command\": [\"loadfile\", \"{path}\", \"append-play\"]}" },
    { "id": "music", "name": "Music", "match": ["*.mp3", "*.flac", "*.ogg", "*.opus", "*.m4a", "*.wav", "*.aac"], "launch": ["mpv", "--input-ipc-server={socket}", "--force-window=immediate", "{paths}"], "enqueue": "{\"command\": [\"loadfile\", \"{path}\", \"append-play\"]}" },
    { "id": "images", "name": "Images", "match": ["*.jpg", "*.jpeg", "*.png", "*.webp", "*.gif", "*.bmp", "*.tif", "*.tiff", "*.svg"], "launch": ["imv", "{path}"], "keymap": "viewer" },
    { "id": "pdf", "name": "PDF", "match": ["*.pdf", "*.epub", "*.djvu"], "launch": ["zathura", "{path}"], "keymap": "viewer" },
    { "id": "text", "name": "Text", "match": ["*.txt", "*.md", "*.log", "*.nfo", "*.json", "*.toml", "*.yaml", "*.yml", "*.ini", "*.conf", "*.cfg", "*.csv", "*.xml", "*.sh", "*.py", "*.rs", "*.c", "*.h"], "launch": ["foot", "less", "{path}"], "keymap": "viewer" },
    { "id": "other", "name": "Other files", "match": ["*"], "launch": ["xdg-open", "{path}"] }
  ],
  "sources": [
    { "type": "dir", "id": "nes", "dir": "~/Games/nes", "place": "nes", "runner": "nes", "also": ["*.zip"], "metadata": "libretro:Nintendo - Nintendo Entertainment System" },
    { "type": "dir", "id": "snes", "dir": "~/Games/snes", "place": "snes", "runner": "snes", "also": ["*.zip"], "metadata": "libretro:Nintendo - Super Nintendo Entertainment System" },
    { "type": "dir", "id": "n64", "dir": "~/Games/n64", "place": "n64", "runner": "n64", "also": ["*.zip"], "metadata": "libretro:Nintendo - Nintendo 64" },
    { "type": "dir", "id": "gb", "dir": "~/Games/gb", "place": "gb", "runner": "gb", "also": ["*.zip"], "metadata": "libretro:Nintendo - Game Boy Color" },
    { "type": "dir", "id": "gba", "dir": "~/Games/gba", "place": "gba", "runner": "gba", "also": ["*.zip"], "metadata": "libretro:Nintendo - Game Boy Advance" },
    { "type": "dir", "id": "nds", "dir": "~/Games/nds", "place": "nds", "runner": "nds", "also": ["*.zip"], "metadata": "libretro:Nintendo - Nintendo DS" },
    { "type": "dir", "id": "md", "dir": "~/Games/md", "place": "md", "runner": "md", "match": ["*.md", "*.gen", "*.bin", "*.zip"], "metadata": "libretro:Sega - Mega Drive - Genesis" },
    { "type": "dir", "id": "psx", "dir": "~/Games/psx", "place": "psx", "runner": "psx", "match": ["*.m3u", "*.chd", "*.cue", "*/*.m3u", "*/*.chd", "*/*.cue"], "metadata": "libretro:Sony - PlayStation" },
    { "type": "dir", "id": "dc", "dir": "~/Games/dc", "place": "dc", "runner": "dc", "also": ["*.chd", "*/*.gdi"], "metadata": "libretro:Sega - Dreamcast" },
    { "type": "dir", "id": "films", "dir": "~/Videos/Films", "place": "films", "match": ["*.mkv", "*.mp4", "*.avi", "*.webm", "*/*.mkv", "*/*.mp4", "*/*.avi", "*/*.webm"], "metadata": "tmdb:movie" },
    { "type": "dir", "id": "tv", "dir": "~/Videos/TV", "place": "tv", "match": ["*/"], "items": ["*.mkv", "*.mp4", "*.avi", "*.webm"], "metadata": "tmdb:tv" },
    { "type": "steam", "place": "steam", "metadata": "steam" },
    { "type": "desktop", "id": "Waydroid", "hide": true },
    { "type": "desktop", "id": "waydroid.*", "place": "apps", "runner": "android" },
    { "type": "desktop", "id": "steam", "place": "apps" },
    { "type": "desktop", "id": "net.lutris.*", "place": "apps" },
    { "type": "desktop", "id": "*heroicgameslauncher*", "place": "apps" },
    { "type": "desktop", "place": "apps", "categories": "Emulator" },
    { "type": "desktop", "place": "games", "categories": "Game" },
    { "type": "desktop", "place": "apps" },
    { "type": "browse", "dir": "~", "in": "files", "name": "Home" },
    { "type": "browse", "dir": "/", "in": "files", "name": "Root" },
    { "type": "browse", "dir": "${XDG_DATA_HOME:-~/.local/share}/Trash/files", "in": "files", "name": "Trash", "trash": true },
    { "type": "removable", "in": "files", "name": "{label}" },
    { "type": "builtin", "id": "device", "place": "tools" }
