    { "id": "nes", "name": "NES", "match": ["*.nes", "*.fds", "*.unf"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/nestopia_libretro.so", "{path}"] },
    { "id": "snes", "name": "SNES", "match": ["*.sfc", "*.smc"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/snes9x_libretro.so", "{path}"] },
    { "id": "n64", "name": "Nintendo 64", "match": ["*.z64", "*.n64", "*.v64"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/mupen64plus_next_libretro.so", "{path}"] },
    { "id": "gb", "name": "Game Boy", "match": ["*.gb", "*.gbc"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/gambatte_libretro.so", "{path}"] },
    { "id": "gba", "name": "Game Boy Advance", "match": ["*.gba"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/mgba_libretro.so", "{path}"] },
    { "id": "nds", "name": "Nintendo DS", "match": ["*.nds"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/melonds_libretro.so", "{path}"] },
    { "id": "megadrive", "name": "Mega Drive", "match": ["*.md", "*.gen", "*.smd"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/genesis_plus_gx_libretro.so", "{path}"] },
    { "id": "mastersystem", "name": "Master System", "match": ["*.sms"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/genesis_plus_gx_libretro.so", "{path}"] },
    { "id": "gamegear", "name": "Game Gear", "match": ["*.gg"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/genesis_plus_gx_libretro.so", "{path}"] },
    { "id": "pcengine", "name": "PC Engine", "match": ["*.pce"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/mednafen_pce_fast_libretro.so", "{path}"] },
    { "id": "saturn", "name": "Saturn", "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/kronos_libretro.so", "{path}"] },
    { "id": "psx", "name": "PlayStation", "match": ["*.cue", "*.chd", "*.m3u", "*.pbp"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/mednafen_psx_hw_libretro.so", "{path}"], "bios": { "dir": "~/.config/retroarch/system", "files": ["scph5500.bin", "scph5501.bin", "scph5502.bin"] } },
    { "id": "psp", "name": "PSP", "match": ["*.cso"], "launch": ["PPSSPPSDL", "--fullscreen", "{path}"] },
    { "id": "dreamcast", "name": "Dreamcast", "match": ["*.gdi", "*.cdi"], "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/flycast_libretro.so", "{path}"] },
    { "id": "arcade", "name": "Arcade", "launch": ["retroarch", "-f", "-L", "/usr/lib/libretro/mame_libretro.so", "{path}"] },
    { "id": "scummvm", "name": "ScummVM", "launch": ["scummvm", "-f", "-p", "{path}", "--auto-detect"] },
    { "id": "video", "name": "Video", "match": ["*.mkv", "*.mp4", "*.m4v", "*.avi", "*.webm", "*.mov", "*.mpg", "*.mpeg", "*.ts", "*.wmv", "*.flv"], "launch": ["mpv", "--input-ipc-server={socket}", "{paths}"], "enqueue": "{\"command\": [\"loadfile\", \"{path}\", \"append-play\"]}" },
    { "id": "music", "name": "Music", "match": ["*.mp3", "*.flac", "*.ogg", "*.opus", "*.m4a", "*.wav", "*.aac"], "launch": ["mpv", "--input-ipc-server={socket}", "--force-window=immediate", "{paths}"], "enqueue": "{\"command\": [\"loadfile\", \"{path}\", \"append-play\"]}" },
    { "id": "images", "name": "Images", "match": ["*.jpg", "*.jpeg", "*.png", "*.webp", "*.gif", "*.bmp", "*.tif", "*.tiff", "*.svg"], "launch": ["imv", "{path}"], "keymap": "viewer" },
    { "id": "pdf", "name": "PDF", "match": ["*.pdf", "*.epub", "*.djvu"], "launch": ["zathura", "{path}"], "keymap": "viewer" },
    { "id": "text", "name": "Text", "match": ["*.txt", "*.md", "*.log", "*.nfo", "*.json", "*.toml", "*.yaml", "*.yml", "*.ini", "*.conf", "*.cfg", "*.csv", "*.xml", "*.sh", "*.py", "*.rs", "*.c", "*.h"], "launch": ["foot", "less", "{path}"], "keymap": "viewer" },
    { "id": "other", "name": "Other files", "match": ["*"], "launch": ["xdg-open", "{path}"] }
  ],
