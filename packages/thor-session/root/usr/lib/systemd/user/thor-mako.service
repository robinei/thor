[Unit]
Description=mako, the notifications (ClamShell's low battery warning, apps'), on the main screen
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
# Its config: the user's (~/.config/mako/config), else the session's.
ExecStart=/bin/sh -c 'if [ -e "$${XDG_CONFIG_HOME:-$$HOME/.config}/mako/config" ]; then exec /usr/bin/mako; else exec /usr/bin/mako --config /usr/share/thor/mako/config; fi'
Restart=on-failure
Slice=session-graphical.slice

[Install]
WantedBy=graphical-session.target
