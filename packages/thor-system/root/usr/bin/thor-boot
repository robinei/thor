#!/bin/bash
# Puts the kernel (linux-thor's), our initramfs and the command line in force on the root's card's FAT
# partition, both ways the card boots: as one selected slot for systemd-boot (which it updates too: the kernel,
# Thor's device tree and initramfs; the loader entry's options line is the command line), and in
# /KERNEL for the ABL, repacked (checked before it replaces the old one). Run as root. pacman runs it after
# updates of the kernel or of what the initramfs and the boot loader are made of (90-thor-boot.hook); the
# first boot, after putting the swap file's place on the command line; the image build, once.
set -euo pipefail
# The previous kernel's modules back, if an update of linux-thor removed them (thor-modules): the card
# boots that kernel until this has put the new one there.
/usr/lib/thor/thor-modules restore
# The kernel: linux-thor's (its Image's folder). (None, as in the test machine's image: Arch's kernel, its
# own package and mkinitcpio boot it.)
kver=$(pacman -Qlq linux-thor 2> /dev/null | sed -n 's|^/usr/lib/modules/\([^/]*\)/Image$|\1|p') || true
[ -n "$kver" ] || { echo "thor-boot: no linux-thor: nothing to do"; exit 0; }
modules=/usr/lib/modules/$kver
echo "thor-boot: kernel and initramfs $kver"
mkinitcpio -k "$kver" -c /usr/lib/thor/mkinitcpio.conf -g /boot/initramfs-thor.img > /var/log/thor-mkinitcpio.log 2>&1 \
    || { tail -20 /var/log/thor-mkinitcpio.log; exit 1; }

# The FAT partition: the first on the card the root is on (another disk may have one too).
part=$(findmnt -nvo SOURCE /)
disk=/dev/$(lsblk -ndo PKNAME "$part")
case $disk in *[0-9]) esp=${disk}p1 ;; *) esp=${disk}1 ;; esac
mnt=/run/thor-esp
work=$(mktemp -d)
mkdir -p "$mnt"
mountpoint -q "$mnt" || mount "$esp" "$mnt"
trap 'umount "$mnt"; rm -rf "$work"' EXIT

cmdline=$(sed -n 's/^options //p' "$mnt/loader/entries/thor.conf")
[ -n "$cmdline" ] || { echo "thor-boot: no options line in the loader entry"; exit 1; }
# Fill the inactive slot, then select the complete set with one loader-entry rename. The slot
# selected now is never written while preparing a replacement.
entry=$mnt/loader/entries/thor.conf
current=$(awk '$1 == "linux" { print $2 }' "$entry")
case $current in
    /thor-a/Image) next=thor-b ;;
    /thor-b/Image) next=thor-a ;;
    *) echo "thor-boot: the loader entry does not select a Thor boot slot: $current"; exit 1 ;;
esac
slot=$mnt/$next
stage=$slot.new
rm -rf "$stage" "$slot"
{ gzip -c "$modules/Image"; cat "$modules"/dtbs/*.dtb; } > "$work/kernel.gz"
need=$(( $(stat -c %s "$modules/Image" /boot/initramfs-thor.img "$modules/dtbs/qcs8550-ayn-thor.dtb" \
    /usr/lib/systemd/boot/efi/systemd-bootaa64.efi "$work/kernel.gz" /boot/initramfs-thor.img | paste -sd+) ))
free=$(( $(stat -f -c '%a * %S' "$mnt") ))
[ "$free" -gt "$(( need + 4 * 1024 * 1024 ))" ] \
    || { echo "thor-boot: insufficient FAT space for $(( need >> 20 )) MiB; selected boot files unchanged"; exit 1; }
mkdir -p "$stage" "$mnt/EFI/BOOT"
cp "$modules/Image" "$stage/Image"
cp "$modules/dtbs/qcs8550-ayn-thor.dtb" "$stage/thor.dtb"
cp /boot/initramfs-thor.img "$stage/initramfs.img"
cp /usr/lib/systemd/boot/efi/systemd-bootaa64.efi "$mnt/EFI/BOOT/BOOTAA64.EFI.new"
# ABL has one coherent image of its own, published independently of the EFI entry.
python3 /usr/lib/thor/bootimg.py repack "$mnt/KERNEL" --kernel "$work/kernel.gz" --ramdisk "$stage/initramfs.img" \
    --cmdline "$cmdline" -o "$mnt/KERNEL.new"
python3 /usr/lib/thor/bootimg.py info "$mnt/KERNEL.new" > /dev/null
awk -v slot="$next" '
    $1 == "linux" { $0 = "linux /" slot "/Image" }
    $1 == "initrd" { $0 = "initrd /" slot "/initramfs.img" }
    $1 == "devicetree" { $0 = "devicetree /" slot "/thor.dtb" }
    { print }
' "$entry" > "$entry.new"
for f in "$stage/Image" "$stage/thor.dtb" "$stage/initramfs.img" "$entry.new" "$mnt/EFI/BOOT/BOOTAA64.EFI.new"; do
    [ "$(stat -c %s "$f")" -gt 0 ] || { echo "thor-boot: $f is empty; selected boot files unchanged"; exit 1; }
done
sync
mv "$stage" "$slot"
mv "$mnt/KERNEL.new" "$mnt/KERNEL"
mv "$mnt/EFI/BOOT/BOOTAA64.EFI.new" "$mnt/EFI/BOOT/BOOTAA64.EFI"
# Order: the renames above on the card before the entry's. FAT orders no metadata writes, so a power cut
# during one sync could keep the entry's rename and lose the slot's, and the entry would name a slot that
# isn't there.
sync -f "$mnt"
# This is the commit point for EFI: all three paths change together.
mv "$entry.new" "$entry"
sync -f "$mnt"
echo "thor-boot: done (slot $next; command line: $cmdline)"
