#!/usr/bin/env python3
"""The top panel's refresh rate calibrated (ROCKNIX's rocknix-panel-calibration, PR #3489): the
ICNA3520's frame length at 120 and 60 Hz, which AYN's Android calibrates per unit (uncalibrated the
panel runs at 118.6 Hz). Started by ClamShell's Device view, as the user (the power group writes the
panel's files): each rate asked of ClamShell for the top screen (`clamshell ctl calibration rate HZ`), its
rate measured from the display's vblanks, the frame length stepped until the rate is just above the
target, and the values saved in /var/lib/thor/panel-calibration, which /usr/lib/thor/panel-calibration
applies at each boot. ClamShell has the bottom screen off meanwhile (its vblanks, always 60 Hz, would be
measured instead: the one display left running is the top's), and sets both screens back when this
ends.

A frame_len_120 that leaves 2 when divided by 4 tints the panel green and raises its gamma
(github.com/armada-os/armada/issues/874; the profile's `tints_at_2_mod_4`): such a value is never
written or saved, but the multiple of 4 below it (the profile's steps of 4 keep the measuring off such
values; this also covers the value it starts from and a saved value it keeps).

  thor-panel-calibration
"""
import fcntl
import glob
import json
import os
import struct
import subprocess
import sys
import time

DRM_IOCTL_WAIT_VBLANK = 0xC018643A
SAVED = "/var/lib/thor/panel-calibration"


def wait(fd, pipe):
    buf = bytearray(struct.pack("IIqq", 1 | pipe << 1, 1, 0, 0))
    fcntl.ioctl(fd, DRM_IOCTL_WAIT_VBLANK, buf)
    _, _, sec, usec = struct.unpack("IIqq", buf)
    return sec + usec / 1e6


def display():
    """A DRM device and the pipe whose vblanks come (the top panel's: the one at the rate set)."""
    for card in sorted(glob.glob("/dev/dri/card*")):
        fd = os.open(card, os.O_RDWR)
        for pipe in range(8):
            try:
                wait(fd, pipe)
                return fd, pipe
            except OSError:
                pass
        os.close(fd)
    sys.exit("no display's vblanks (the top screen off?)")


def rate(fd, pipe):
    ts, end = [], time.monotonic() + 0.5
    while time.monotonic() < end:
        ts.append(wait(fd, pipe))
    return (len(ts) - 1) / (ts[-1] - ts[0])


def write(attr, value):
    with open(attr, "w") as f:
        f.write(str(value))
    time.sleep(0.5)


def untinted(calibration, value):
    """`value`, or if the panel tints at it the multiple of 4 below (of the two nearest values known not
    to tint, the one with the higher rate), said on stderr."""
    if calibration.get("tints_at_2_mod_4") and value % 4 == 2:
        print(f"{calibration['attribute']}={value} tints the panel (armada-os/armada#874): {value - 2} instead", file=sys.stderr)
        return value - 2
    return value


def calibrate(attr, target, calibration, step_size, fd, pipe):
    """The frame length that puts the rate just above `target` (ROCKNIX's steps and tolerances), or
    None (the value it started from written back)."""
    tolerance, big_error = calibration["tolerance_millihz"] / 1000, calibration["big_error_millihz"] / 1000
    low, high = calibration["low"], calibration["high"]
    start = untinted(calibration, int(open(attr).read()))
    value = untinted(calibration, start // step_size * step_size)
    try:
        start_rate = rate(fd, pipe)
        deadline, adjust_until = time.monotonic() + 60, time.monotonic() + 15
        write(attr, value)
        while time.monotonic() < deadline:
            delta = rate(fd, pipe) - target
            settled = 0 <= delta <= tolerance
            if time.monotonic() < adjust_until:
                if not settled:
                    step = step_size if abs(delta) < big_error else 2 * step_size
                    value = untinted(calibration, min(high, max(low, value + (step if delta > 0 else -step))))
                    write(attr, value)
            elif settled:
                print(f"{target} Hz: {start_rate:.3f} -> {target + delta:.3f} Hz (0x{start:x} -> 0x{value:x})")
                return value
            else:
                adjust_until = time.monotonic() + 3.75
        print(f"{target} Hz: no stable value in range", file=sys.stderr)
    except OSError as e:
        print(f"{target} Hz: {e}", file=sys.stderr)
    # (The value it started from, back; if even that fails, as it is.)
    try:
        write(attr, start)
    except OSError as e:
        print(f"{target} Hz: not set back: {e}", file=sys.stderr)
    return None


def save(path, rates, found):
    """The rates `found` ({hz: value}) into `path`; a rate not found keeps its saved value, untinted."""
    saved = {}
    try:
        with open(path) as f:
            saved = dict(line.strip().split("=", 1) for line in f if "=" in line)
    except OSError:
        pass
    saved.update({calibration["attribute"]: str(found[calibration["hz"]]) for calibration in rates if calibration["hz"] in found})
    # (A kept value that tints, one written by hand, saved as it is applied.)
    for calibration in rates:
        kept = saved.get(calibration["attribute"], "")
        if kept.isdigit():
            saved[calibration["attribute"]] = str(untinted(calibration, int(kept)))
    # (In place, as one write, synced: the folder is root's, so no new file can be renamed over it; a write
    # cut short leaves it empty, which reads as uncalibrated.)
    with open(path, "w") as f:
        f.write("".join(f"{k}={v}\n" for k, v in sorted(saved.items())))
        f.flush()
        os.fsync(f.fileno())


def ask_rate(hz):
    """The top screen at `hz`, asked of ClamShell, which sets it while the calibration runs."""
    subprocess.run(["clamshell", "ctl", "calibration", "rate", str(hz)], check=True, capture_output=True)


def main():
    facts = json.loads(subprocess.run(["clamshell", "device", "panel"], capture_output=True, text=True, check=True).stdout)
    settings = facts["calibration"]
    if not settings or not settings["rates"]:
        sys.exit("no calibratable panel in the device profile")
    rates = settings["rates"]
    panel = next(iter(glob.glob(f"/sys/bus/mipi-dsi/devices/*/{rates[0]['attribute']}")), None)
    if not panel:
        sys.exit("calibratable panel not found")
    panel = os.path.dirname(panel)
    try:
        os.sched_setscheduler(0, os.SCHED_FIFO, os.sched_param(10))
    except OSError:
        pass
    found = {}
    # (The bottom screen off by now: ClamShell turned it off as it started this.)
    time.sleep(1)
    # (The top's pipe, the one display left running: found once, kept across its modes.)
    fd, pipe = display()
    for calibration in rates:
        target = calibration["hz"]
        ask_rate(target)
        time.sleep(2)
        value = calibrate(f"{panel}/{calibration['attribute']}", target, calibration, settings["step"], fd, pipe)
        if value is not None:
            found[target] = value
    os.close(fd)
    if not found:
        sys.exit("no rate calibrated")
    save(SAVED, rates, found)
    print(f"saved in {SAVED}")
    if len(found) < len(rates):
        sys.exit("one rate not calibrated (the other saved)")


if __name__ == "__main__":
    main()
