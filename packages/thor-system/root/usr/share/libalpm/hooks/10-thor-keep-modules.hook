# Before linux-thor is updated: a copy of the running kernel's modules and of the installed one's (the
# card boots that until thor-boot has put the new kernel there: thor-modules).
[Trigger]
Operation = Upgrade
Type = Package
Target = linux-thor

[Action]
Description = Keeping the running kernel's modules until the new kernel is on the card...
When = PreTransaction
Exec = /usr/lib/thor/thor-modules keep
