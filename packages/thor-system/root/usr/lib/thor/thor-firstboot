#!/bin/bash
# The card's first boot (thor-firstboot.service, once): grow the root partition (the last one) and its
# filesystem to the card; make the swap file /swapfile (16 GiB, the RAM, if the card leaves 8 GiB free
# beside it; else no hibernate, suspend only); then add resume=LABEL=THOR_ROOT and resume_offset= (the
# file's first block, known only once it exists) to the loader entry's options line, and thor-boot puts
# that command line into /KERNEL too. The resume settings take effect from the next boot; hibernating works
# in the first session already (systemd-sleep tells the kernel where the swap file is before hibernating).
set -euo pipefail
SWAP_GIB=16
part=$(findmnt -nvo SOURCE /)
disk=/dev/$(lsblk -ndo PKNAME "$part")
num=$(cat "/sys/class/block/${part#/dev/}/partition")
echo "growing $part (partition $num of $disk) to the card"
growpart "$disk" "$num" || echo "growpart: no change"
resize2fs "$part"

if [ ! -e /swapfile ]; then
    # (Made beside, and moved into place only once it is swap: a run cut off before leaves no /swapfile
    # that isn't, which a rerun would take as done.)
    rm -f /swapfile.new
    free=$(df --output=avail -B1G / | tail -1)
    if (( free >= SWAP_GIB + 8 )); then
        echo "making /swapfile, $SWAP_GIB GiB"
        fallocate -l "${SWAP_GIB}G" /swapfile.new
        chmod 600 /swapfile.new
        mkswap /swapfile.new
        mv /swapfile.new /swapfile
    else
        echo "$free GiB free: no swap file, so no hibernate (suspend only)"
    fi
fi

if [ -e /swapfile ]; then
    # Creation may have completed before an earlier run stopped. Reconcile the remaining steps even
    # when the file was already there; publish fstab as a whole, so an interrupted append cannot stick.
    if ! awk '$1 == "/swapfile" && $3 == "swap" { found = 1 } END { exit !found }' /etc/fstab; then
        fstab=$(mktemp /etc/.fstab.XXXXXX)
        awk '$1 != "/swapfile"' /etc/fstab > "$fstab"
        echo '/swapfile none swap defaults 0 0' >> "$fstab"
        chmod --reference=/etc/fstab "$fstab"
        mv "$fstab" /etc/fstab
    fi
    if ! swapon --show=NAME --noheadings | grep -qx /swapfile; then
        swapon /swapfile
    fi
    # The file's first block (ext4 blocks and pages are both 4 KiB here, so it is the offset in pages).
    offset=$(filefrag -v /swapfile | awk '$1 == "0:" { sub(/\.\.$/, "", $4); print $4 }')
    [[ $offset =~ ^[0-9]+$ ]] || { echo "could not read the swap file's resume offset" >&2; exit 1; }
    case $disk in *[0-9]) esp=${disk}p1 ;; *) esp=${disk}1 ;; esac
    # (thor-boot's lock, for the mount point and the entry it shares with it; released before thor-boot
    # runs, which takes it again.)
    (
        flock 9
        mkdir -p /run/thor-esp
        # (A run cut off before may have left it mounted.)
        mountpoint -q /run/thor-esp || mount "$esp" /run/thor-esp
        entry=/run/thor-esp/loader/entries/thor.conf
        # (The options, joined as systemd-boot joins several lines, without any resume= of before, then
        # this file's, as one line where the first was. awk takes them as they are: a sed replacement
        # would read & and its separator in them.)
        options=$(sed -n 's/^options //p' "$entry" | paste -sd ' ' | sed -E 's/ ?resume(_offset)?=[^ ]*//g')
        options="$options resume=LABEL=THOR_ROOT resume_offset=$offset" awk '
            $1 == "options" { if (!done) print "options " ENVIRON["options"]; done = 1; next }
            { print }
        ' "$entry" > "$entry.new"
        mv "$entry.new" "$entry"
        umount /run/thor-esp
    ) 9> /run/thor-boot.lock
    sync -f /etc/fstab
    thor-boot
fi
touch /var/lib/thor-firstboot
