#!/bin/sh
# The kernels' modules across an update of linux-thor. Each version of the kernel has its own release (its
# modules' folder: linux-thor's PKGBUILD), and pacman removes the old one's folder as it installs the new
# one. Until the new kernel is on the card (thor-boot) and running, two others still need theirs: the one
# running, and the one on the card (installed: after an update without a reboot since, not the same).
# So:
#
#   thor-modules keep      before the update (10-thor-keep-modules.hook): a copy of the running kernel's
#                          modules and of the installed one's, /usr/lib/modules/.thor-kept-<release>
#   thor-modules restore   after it (thor-boot, first, whether or not it then succeeds): each copy back where
#                          it was if the update removed that, else dropped
#   thor-modules clean     at boot (thor-old-modules.service): copies an interrupted update left restored,
#                          then module folders no package owns, other than the running kernel's, removed
set -eu
dir=/usr/lib/modules
case ${1:-} in
    keep)
        # (The running kernel's: in an image's build, the build machine's, so nothing of it here.)
        installed=$(pacman -Qlq linux-thor 2> /dev/null | sed -n 's|^/usr/lib/modules/\([^/]*\)/Image$|\1|p')
        for release in $(uname -r) $installed; do
            [ -d "$dir/$release" ] || continue
            rm -rf "$dir/.thor-kept-$release"
            cp -a "$dir/$release" "$dir/.thor-kept-$release"
        done
        ;;
    restore)
        for kept in "$dir"/.thor-kept-*; do
            [ -d "$kept" ] || continue
            release=${kept##*/.thor-kept-}
            if [ -e "$dir/$release" ]; then
                rm -rf "$kept"
            else
                mv "$kept" "$dir/$release"
                echo "thor-modules: $release's modules kept for the kernel still on the card"
            fi
        done
        ;;
    clean)
        "$0" restore
        running=$(uname -r)
        for release in "$dir"/*/; do
            release=$(basename "$release")
            [ "$release" = "$running" ] && continue
            pacman -Qqo "$dir/$release" > /dev/null 2>&1 && continue
            rm -rf "${dir:?}/$release"
            echo "thor-modules: $release's modules removed (not running, no package's)"
        done
        ;;
    *) echo "thor-modules keep|restore|clean"; exit 2 ;;
esac
