#!/bin/bash
# The session user's account, for ClamShell's Device view (Password, Remote login), run as root through
# pkexec (polkit lets the active local session's user run it without asking: 50-thor.rules). The user is
# pkexec's caller (PKEXEC_UID). The image starts with the account locked (no password): no sudo, no
# ssh, until a password is set here.
#
#   thor-account status       "password set|none" and "ssh on|off", a line each
#   thor-account password     stdin: the new password (only while none is set), or the current one and
#                             the new one, a line each. The first password is set only once Volume Up is
#                             pressed on a physical device within 20 s (`clamshell device confirm`): any
#                             process of the session's user could run this helper, and only someone holding
#                             the device can press the key.
#   thor-account ssh on|off   sshd enabled and started, or disabled and stopped (on: only with a password)
#
# Errors: exit 1 and a line on stderr: "wrong password", "too short" (under 8 characters), "Volume Up not
# pressed", "set a password first", "failed".
#
# The password is sudo's and ssh's: Remote login takes it (sshd's 50-thor.conf: thor only, 3 tries per
# connection), and through it a key can be added (~/.ssh/authorized_keys); at least 8 characters, as it
# guards root over the network.
set -u
fail() { echo "$1" >&2; exit 1; }

uid=${PKEXEC_UID:-}
[ -n "$uid" ] && [ "$uid" != 0 ] || fail "failed"
user=$(id -nu "$uid" 2> /dev/null) || fail "failed"

# Set: a hash, not empty and not locked ("!" or "*" first).
has_password() {
    local hash
    hash=$(getent shadow "$user" | cut -d: -f2)
    [ -n "$hash" ] && [ "${hash#[!*]}" = "$hash" ]
}

case ${1:-} in
    status)
        if has_password; then echo "password set"; else echo "password none"; fi
        if systemctl -q is-enabled sshd 2> /dev/null; then echo "ssh on"; else echo "ssh off"; fi
        ;;
    password)
        if has_password; then
            IFS= read -r current || fail "failed"
            IFS= read -r new || fail "failed"
            # The current one checked as PAM checks it, by the user's own unix_chkpwd (the password and a
            # NUL on its input).
            printf '%s\0' "$current" | runuser -u "$user" -- /usr/bin/unix_chkpwd "$user" nonull 2> /dev/null \
                || fail "wrong password"
        else
            IFS= read -r new || fail "failed"
            [ "${#new}" -ge 8 ] || fail "too short"
            /usr/bin/clamshell device confirm 2> /dev/null || fail "Volume Up not pressed"
        fi
        [ "${#new}" -ge 8 ] || fail "too short"
        printf '%s:%s\n' "$user" "$new" | chpasswd 2> /dev/null || fail "failed"
        ;;
    ssh)
        case ${2:-} in
            on)
                has_password || fail "set a password first"
                systemctl enable --now -q sshd || fail "failed"
                ;;
            off) systemctl disable --now -q sshd || fail "failed" ;;
            *) fail "failed" ;;
        esac
        ;;
    *)
        echo "usage: thor-account status | password | ssh on|off" >&2
        exit 2
        ;;
esac
