#!/bin/sh
# Bluetooth off while asleep: its UART's clock keeps the SoC's crystal on, so the SoC never sleeps fully
# (PB-OS's sm8550-sleep). Only an adapter that is on (ClamShell turns it off through BlueZ, which
# would power it again when unblocked); turned back on after, only if this turned it off (a mark in
# /run).
mark=/run/thor-bluetooth-off
case $1 in
    pre)
        if busctl get-property org.bluez /org/bluez/hci0 org.bluez.Adapter1 Powered 2> /dev/null | grep -q true \
            && rfkill list bluetooth 2> /dev/null | grep -q 'Soft blocked: no'; then
            rfkill block bluetooth && touch "$mark"
        fi
        ;;
    post)
        if [ -e "$mark" ]; then
            rm -f "$mark"
            rfkill unblock bluetooth
        fi
        ;;
esac
exit 0
