From: lavachemist <48248311+lavachemist@users.noreply.github.com>
Subject: [PATCH] power: supply: qcom_battmgr: no battery notifications while asleep (SM8550)

The Pocket FIT's 0015 for the SM8550 kernel. With 0505 an ADSP doorbell
wakes the system from sleep (so a charger plugged in during deep sleep is
seen), and the charger firmware's battery notifications every few minutes
would wake it too. Downstream qti_battery_charger sends
BC_DISABLE_NOTIFY_REQ (0x05) when the panel blanks and BC_SET_NOTIFY_REQ
(0x04) when it unblanks; do the same around system sleep (dev_pm_ops
prepare/complete) and refresh the battery and USB state after wake. The
charger's plug-in and unplug still reach Linux through UCSI's connector
change notification.

Pocket FIT: a 6 h 05 min deep sleep with no self-wake (was 13-43 min).

Ported to Armada's tree after PB-OS's 0545 (which sets the same driver data
for its switches); otherwise as PB-OS's 0547 (project-barry/pb-os 8ea4653).
---
diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index eaca3b13f..400db6a0b 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -32,6 +32,7 @@ enum qcom_battmgr_variant {
 #define BATTMGR_BAT_STATUS		0x1
 
 #define BATTMGR_REQUEST_NOTIFICATION	0x4
+#define BATTMGR_DISABLE_NOTIFICATION	0x5
 
 #define BATTMGR_NOTIFICATION		0x7
 #define NOTIF_BAT_PROPERTY		0x30
@@ -1330,6 +1331,7 @@ static void qcom_battmgr_sc8280xp_callback(struct qcom_battmgr *battmgr,
 
 	switch (opcode) {
 	case BATTMGR_REQUEST_NOTIFICATION:
+	case BATTMGR_DISABLE_NOTIFICATION:
 		battmgr->error = 0;
 		break;
 	case BATTMGR_BAT_INFO:
@@ -1637,6 +1639,7 @@ static void qcom_battmgr_sm8350_callback(struct qcom_battmgr *battmgr,
 		}
 		break;
 	case BATTMGR_REQUEST_NOTIFICATION:
+	case BATTMGR_DISABLE_NOTIFICATION:
 	case BATTMGR_CHG_CTRL_LIMIT_EN:
 	case BATTMGR_USB_PROPERTY_SET:
 		battmgr->error = 0;
@@ -1894,6 +1897,7 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 	if (IS_ERR(battmgr->client))
 		return PTR_ERR(battmgr->client);
 
+	auxiliary_set_drvdata(adev, battmgr);
 	pmic_glink_client_register(battmgr->client);
 
 	if (of_machine_is_compatible("retroidpocket,rp6") ||
@@ -1916,8 +1920,62 @@ static const struct auxiliary_device_id qcom_battmgr_id_table[] = {
 };
 MODULE_DEVICE_TABLE(auxiliary, qcom_battmgr_id_table);
 
+/*
+ * The ADSP charger firmware sends battery
+ * notifications every few minutes, and in PSCI system suspend each one
+ * resumes the whole system. Qualcomm's downstream qti_battery_charger sends
+ * BC_DISABLE_NOTIFY_REQ (0x5) when the panel blanks and BC_SET_NOTIFY_REQ
+ * (0x4) when it unblanks; do the same around system sleep and refresh the
+ * battery state afterwards.
+ */
+static int qcom_battmgr_set_notify(struct qcom_battmgr *battmgr, bool enable)
+{
+	struct qcom_battmgr_enable_request req = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_NOTIFY),
+		.hdr.opcode = cpu_to_le32(enable ? BATTMGR_REQUEST_NOTIFICATION :
+						   BATTMGR_DISABLE_NOTIFICATION),
+	};
+
+	return qcom_battmgr_request(battmgr, &req, sizeof(req));
+}
+
+static int qcom_battmgr_pm_prepare(struct device *dev)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	int ret;
+
+	if (!battmgr || !battmgr->service_up)
+		return 0;
+	ret = qcom_battmgr_set_notify(battmgr, false);
+	dev_info(dev, "battery notifications off for sleep: %d\n", ret);
+	return 0;
+}
+
+static void qcom_battmgr_pm_complete(struct device *dev)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	int ret;
+
+	if (!battmgr || !battmgr->service_up)
+		return;
+	ret = qcom_battmgr_set_notify(battmgr, true);
+	dev_info(dev, "battery notifications on after sleep: %d\n", ret);
+	if (battmgr->bat_psy)
+		power_supply_changed(battmgr->bat_psy);
+	/* A charger plugged in or pulled while asleep. */
+	if (battmgr->usb_psy)
+		power_supply_changed(battmgr->usb_psy);
+}
+
+static const struct dev_pm_ops qcom_battmgr_pm_ops = {
+	.prepare = qcom_battmgr_pm_prepare,
+	.complete = qcom_battmgr_pm_complete,
+};
+
 static struct auxiliary_driver qcom_battmgr_driver = {
 	.name = "pmic_glink_power_supply",
+	.driver.pm = &qcom_battmgr_pm_ops,
 	.probe = qcom_battmgr_probe,
 	.id_table = qcom_battmgr_id_table,
 };
