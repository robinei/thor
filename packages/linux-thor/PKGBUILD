# Linus Torvalds', Greg Kroah-Hartman's (keys/pgp, as Arch's linux has them).
validpgpkeys=(ABAF11C65A2970B130ABE3C479BE3E4300411886
              647F28654894E3BD457199BE38DBBDC86092693E)

_make() { make -C "$srcdir/linux-$_kver" ARCH=arm64 LLVM=1 "$@"; }

prepare() {
    local src=$srcdir/linux-$_kver k=$srcdir/armada-$_armada/packages/kernel patch
    [ "$(. "$k/BASE.env"; echo "$VERSION")" = "$_kver" ] || { echo "Armada's BASE.env isn't Linux $_kver"; return 1; }
    # (Each applied with no fuzz and every hunk required, as Armada's build does.)
    _apply() {
        local log expected
        log=$(patch -d "$src" -p1 --batch --forward -F0 --dry-run --verbose < "$1" 2>&1) || { echo "$log"; echo "doesn't apply: $1"; return 1; }
        expected=$(grep -c '^@@ ' "$1" || true)
        [ "$(grep -c '^Hunk #[0-9].*succeeded' <<< "$log" || true)" -eq "$expected" ] || { echo "$log"; echo "not every hunk applies: $1"; return 1; }
        patch -d "$src" -p1 --batch --forward -F0 --no-backup-if-mismatch -s < "$1"
    }
    while read -r patch; do
        _apply "$k/patches/$patch"
    done < <(sed 's/#.*//' "$k/patches/series" | awk 'NF { print $1 }')
    cp "$k"/dts/*.dts "$k"/dts/*.dtsi "$src/arch/arm64/boot/dts/qcom/"
    # (Applied straight, as Armada's build does: a file may hold several patches to the same source, so a
    # dry run of the whole would fail on the second.)
    for patch in "$k"/dts/*.patch; do
        patch -d "$src" -p1 --batch --forward -F0 --no-backup-if-mismatch -s < "$patch" || { echo "doesn't apply: $patch"; return 1; }
    done
    for patch in "$k"/dts/*.dts; do
        echo "dtb-\$(CONFIG_ARCH_QCOM) += $(basename "$patch" .dts).dtb"
    done >> "$src/arch/arm64/boot/dts/qcom/Makefile"
    # Ours, after theirs.
    for patch in "${source[@]}"; do
        [[ $patch == *.patch ]] || continue
        echo "ours: $patch"
        _apply "$srcdir/$patch"
    done

    # The config: arm64's defconfig, Armada's overrides, ours, the release (Armada's commit and pkgrel:
    # each version of this package its own modules' folder).
    local release=-thor-${_armada:0:7}-$pkgrel
    {
        # (kconfig can't read comments after an assignment.)
        sed -E '/^[[:space:]]*CONFIG_[A-Z0-9_]+=/ s/[[:space:]]*#.*$//' "$k/config/armada-kernel.config.overrides"
        grep -v '^#' "$srcdir/config.thor"
        echo "CONFIG_LOCALVERSION=\"$release\""
    } > "$srcdir/config.fragment"
    _make -s defconfig
    (cd "$src" && ARCH=arm64 LLVM=1 bash scripts/kconfig/merge_config.sh -m .config "$srcdir/config.fragment" > /dev/null)
    _make -s olddefconfig
    # (Those asked for as built in, as Armada's build checks, and ours.)
    local lost
    lost=$(grep -E '^CONFIG_[A-Z0-9_]+=y$|^CONFIG_(LOCALVERSION|INITRAMFS_SOURCE|ANDROID_BINDER_DEVICES)=' "$srcdir/config.fragment" \
        | while read -r want; do grep -qxF "$want" "$src/.config" || echo "$want"; done)
    [ -z "$lost" ] || { echo "didn't survive Kconfig's dependencies:"; echo "$lost"; return 1; }
    # (The configuration the build reads, include/config/auto.conf, made from .config now: olddefconfig
    # leaves defconfig's, and the release would come out without ours.)
    _make -s syncconfig
    [ "$(_make -s kernelrelease)" = "$_kver$release" ] \
        || { echo "the kernel's release is $(_make -s kernelrelease), not $_kver$release"; return 1; }
}

# The SM8550 boards' device trees (ROCKNIX's ABL picks one by its Device model; the EFI path loads the Thor's).
_dtbs() {
    local dts
    for dts in "$srcdir/armada-$_armada"/packages/kernel/dts/qcs8550-*.dts; do echo "qcom/$(basename "$dts" .dts).dtb"; done
}

# (Reproducible: who and where built it not recorded in /proc/version, its time the source's:
# SOURCE_DATE_EPOCH, makepkg's, tools/repo/build.sh sets it to the commit's.)
export KBUILD_BUILD_USER=thor KBUILD_BUILD_HOST=thor

build() {
    # (makepkg's flags are for userspace; the kernel takes its own.)
    unset CFLAGS CXXFLAGS LDFLAGS RUSTFLAGS
    KBUILD_BUILD_TIMESTAMP=$(date -u -d "@${SOURCE_DATE_EPOCH:-0}") DTC_FLAGS=-@ _make Image modules $(_dtbs)
}

package() {
    local src=$srcdir/linux-$_kver release dtb
    release=$(cat "$src/include/config/kernel.release")
    local modules=$pkgdir/usr/lib/modules/$release
    _make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 modules_install > /dev/null
    rm -f "$modules/build" "$modules/source"
    install -m644 "$src/arch/arm64/boot/Image" "$modules/Image"
    for dtb in $(_dtbs); do install -Dm644 "$src/arch/arm64/boot/dts/$dtb" "$modules/dtbs/$(basename "$dtb")"; done
    install -m644 "$src/.config" "$modules/config"
    printf "Armada's kernel, commit %s: Linux %s; built with %s from github.com/robinei/thor %s\n" "$_armada" "$_kver" \
        "$(clang --version | head -1)" "${THOR_COMMIT:-(a checkout)}" > "$modules/thor-source"
    # GPL-2.0: the kernel's license files, and where its corresponding source is.
    local licenses=$pkgdir/usr/share/licenses/$pkgname
    install -Dm644 "$src/COPYING" "$licenses/COPYING"
    cp -r --no-preserve=ownership "$src/LICENSES" "$licenses/"
    printf '%s\n' "The corresponding source of this kernel (GPL-2.0): its source package," \
        "$pkgname-$pkgver-$pkgrel.src.tar.gz, at https://github.com/robinei/thor/releases/tag/packages while" \
        "this version is the repository's (this PKGBUILD, kernel.org's tarball, Armada's repository at commit" \
        "$_armada, our patches and config); and always: packages/linux-thor at github.com/robinei/thor" \
        "commit ${THOR_COMMIT:-(see thor-source)}, whose sources are checksummed and public." \
        > "$licenses/SOURCE"
    # (No pkgbase file: mkinitcpio's own hook would make a preset for it and look for /boot/vmlinuz-*;
    # thor-boot makes our initramfs.)
}
