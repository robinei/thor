# Armada's kernel for the AYN Thor (github.com/armada-os/armada, packages/kernel: their Linux version, patch
# series, device trees and config) with our few changes, as Arch Linux ARM's linux-aarch64 is made: the
# sources pinned and checked here (kernel.org's tarball, signed; Armada's repository at a commit), built in
# build(), cross-compiled with LLVM on an x86_64 PC (tools/repo/build.sh) or natively. Armada carries the
# furthest community work for the Thor (ROCKNIX's stack, newer, with Thorch's, Pocknix's, Kettle's and
# their own; each patch's source in their PATCHES.md). Its corresponding source (GPL-2.0) is this package's
# source package, makepkg --allsource's, published beside it.
#
# Following Armada: tools/repo/follow-armada.sh [COMMIT] sets _armada, _armada_time and _kver here and the
# checksums, after reading what changed in their packages/kernel; then build, and try it on the device. A
# change of ours alone (a patch below, our config lines): pkgrel up (it is in the kernel's release, so the
# new build's modules go beside the old ones).
#
# As Armada's scripts/build-kernel.sh: their patches/series in order, each applied without fuzz; their
# dts/*.dts(i) copied into arch/arm64/boot/dts/qcom, then their dts/*.patch; defconfig with
# config/armada-kernel.config.overrides merged, each =y checked. Then ours: the .patch files in source=,
# in order (see source=); config.thor; a release of its own per package version,
# -thor-<Armada's commit>-<pkgrel>, so that an update's modules go beside the running and installed
# kernels' (thor-system keeps those until the new kernel is on the card). Differing from theirs: LLVM
# instead of GCC; no built-in initramfs (ours comes from the boot loader: thor-boot); modules stripped of
# debug information (as theirs). The Image and the SM8550 device trees go beside the modules
# (/usr/lib/modules/<release>), where thor-boot (thor-system) takes them for both ways the card boots.
pkgname=linux-thor
_kver=7.2.6
_armada=d2bcf6fd33435f670f59a164c926842af91730f1
# (Armada's commit's time: the version after the kernel's, so that their newer commit is a newer package.)
_armada_time=202610202319
pkgver=$_kver.$_armada_time
pkgrel=6
pkgdesc="Armada's Linux kernel for the AYN Thor (SM8550), with its modules and device trees"
arch=(aarch64)
url=https://github.com/armada-os/armada
license=(GPL-2.0-only)
depends=(kmod mkinitcpio)
makedepends=(clang lld llvm bc flex bison perl python cpio)
provides=(linux)
options=(!strip !debug)
source=("https://cdn.kernel.org/pub/linux/kernel/v${_kver%%.*}.x/linux-$_kver.tar."{xz,sign}
        "armada-$_armada.tar.gz::https://github.com/armada-os/armada/archive/$_armada.tar.gz"
        config.thor
        # Ours, in this order (each made against the tree the ones before it leave). pbos-*: PB-OS's
        # (github.com/project-barry/pb-os, external-and-mods/kernel-sm8650/sm8550, at 8ea4653; each one's
        # header says what of it is ours), tested on a Thor there unless its header says otherwise:
        # the battery firmware's own charge switches (ClamShell's CLAMSHELL_CHARGE_LIMIT=firmware),
        # the bottom panel's brightness, the bottom touchscreen's lost contacts, the battery's power,
        # FastRPC to the ADSP's sensor hub (the motion sensors), deep sleep's wake by a charger and no
        # battery notifications while asleep (0505 changes deep sleep only; 0547 any sleep). thor-*: the
        # body's motor as an LRA (PB-OS's device tree lines), the gamepad MCU's joystick frame settable,
        # the sensor hub's device tree nodes (PB-OS's).
        pbos-0545-power-supply-qcom_battmgr-retroid-charge-controls.patch
        thor-0001-dts-thor-lra-haptics.patch
        pbos-0620-drm-panel-ch13726a-thor-16-bit-brightness-high-byte-first.patch
        pbos-0630-input-edt-ft5x06-release-contacts-the-controller-drops.patch
        pbos-0546-power-supply-qcom_battmgr-power-now.patch
        thor-0002-rsinput-mcu-frame-settable.patch
        pbos-0560-misc-fastrpc-adsp-sensors-pd-routing-and-legacy-ioctl.patch
        thor-0003-dts-thor-adsp-sensors.patch
        pbos-0505-mailbox-qcom-ipcc-let-a-doorbell-wake-the-system-once-it-is-down.patch
        pbos-0547-power-supply-qcom_battmgr-no-battery-notifications-while-asleep.patch)
sha256sums=(039aef84f2b0994aeda3f4fcfc3d02ec9d7a9bbb9020ea264c43f446c860f606
            SKIP
