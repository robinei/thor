From: thor <thor@localhost>
Subject: [PATCH] drm/panel: icna35xx: the ICNA3520 frame length calibrated per unit

ROCKNIX's 0509 (ROCKNIX/distribution PR #3489, c790c23d7b7d, by Jacob Cook,
tested on a Thor: the top panel 118.63 Hz uncalibrated, 120.09 Hz after) ported
to Armada's driver: frame_len_120 and frame_len_60 on the panel's device,
applied at once while the panel streams in that rate (Armada's enabled
flag), else at its next prepare. thor-system's thor-panel-calibration
finds a unit's values and applies the saved ones at boot.
---
diff --git a/drivers/gpu/drm/panel/panel-chipone-icna35xx.c b/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
index 2d8d4720e..267c6fd0c 100644
--- a/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
+++ b/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
@@ -35,6 +35,11 @@ struct panel_info {
 	struct backlight_device *backlight;
 	struct drm_panel_bl_levels bl_levels;
 	bool enabled;
+
+	/* The ICNA3520's frame lengths at 120 and 60 Hz (calibrated per unit) and the mode's rate. */
+	int vrefresh;
+	u16 frame_len_120;
+	u16 frame_len_60;
 };
 
 struct panel_desc {
@@ -57,6 +62,10 @@ struct panel_desc {
 	unsigned int enter_sleep_ms;
 
 	struct drm_dsc_config dsc;
+
+	/* The ICNA3520's frame lengths before calibration (0: none to calibrate). */
+	u16 frame_len_120;
+	u16 frame_len_60;
 };
 
 static const struct regulator_bulk_data panel_supplies[] = {
@@ -191,6 +200,32 @@ static int icna3512_init_sequence(struct panel_info *pinfo)
 	return dsi_ctx.accum_err;
 }
 
+static void icna3520_set_frame_len(struct mipi_dsi_multi_context *dsi_ctx,
+				   struct panel_info *pinfo)
+{
+	u8 payload_120[] = {
+		0xB3,
+		0x00, 0xD8, 0x00, 0x1C,
+		pinfo->frame_len_120 >> 8, pinfo->frame_len_120 & 0xff,
+	};
+	u8 payload_60[] = {
+		0xB3,
+		0x00, 0xDB, 0x00, 0x1C, 0x00, 0x1C, 0x00,
+		0x00, 0xDB, 0x00, 0x1C,
+		pinfo->frame_len_60 >> 8, pinfo->frame_len_60 & 0xff, 0x00,
+	};
+
+	if (pinfo->vrefresh == 120) {
+		mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x48, 0x00);
+		mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x9F, 0x00);
+		mipi_dsi_generic_write_multi(dsi_ctx, payload_120, sizeof(payload_120));
+	} else {
+		mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x48, 0x10);
+		mipi_dsi_generic_write_seq_multi(dsi_ctx, 0x9F, 0x00);
+		mipi_dsi_generic_write_multi(dsi_ctx, payload_60, sizeof(payload_60));
+	}
+}
+
 static int icna3520_init_sequence(struct panel_info *pinfo)
 {
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
@@ -214,19 +249,8 @@ static int icna3520_init_sequence(struct panel_info *pinfo)
 
 	mipi_dsi_msleep(&dsi_ctx, 120);
 
-	if (cur_vrefresh == 120) {
-		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x00);
-		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9F, 0x00);
-		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB3, 
-                0x00, 0xD8, 0x00, 0x1C, 0x00, 0x4C);
-	}
-	else {
-		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x10);
-		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9F, 0x00);
-		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB3, 
-                0x00, 0xDB, 0x00, 0x1C, 0x00, 0x1C, 0x00, 0x00,
-				0xDB, 0x00, 0x1C, 0x07, 0xD6, 0x00);
-	}
+	pinfo->vrefresh = cur_vrefresh;
+	icna3520_set_frame_len(&dsi_ctx, pinfo);
 
 	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9F, 0x01);
 	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB2, 0x00);
@@ -507,6 +531,8 @@ static struct panel_desc icna3520_desc = {
 	.bl_num_interp = 32,
 	.display_off_ms = 50,
 	.enter_sleep_ms = 120,
+	.frame_len_120 = 0x4C,
+	.frame_len_60 = 0x7D6,
 	.dsc = {
 		.dsc_version_major = 0x1,
 		.dsc_version_minor = 0x1,
@@ -729,6 +755,87 @@ static struct backlight_device *icna35xx_create_backlight(struct mipi_dsi_device
 					      &icna35xx_bl_ops, &props);
 }
 
+/*
+ * The ICNA3520's frame lengths, calibrated per unit (ROCKNIX's 0509, PR #3489: AYN's Android calibrates
+ * each Thor's; uncalibrated the top panel runs at 118.6 Hz). A write takes effect at once while the
+ * panel streams in that rate's mode, else at its next prepare.
+ */
+static ssize_t icna3520_frame_len_store(struct device *dev, u16 *frame_len,
+					int vrefresh, u16 min, u16 max,
+					const char *buf, size_t count)
+{
+	struct panel_info *pinfo = dev_get_drvdata(dev);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
+	u16 val;
+	int ret;
+
+	ret = kstrtou16(buf, 0, &val);
+	if (ret)
+		return ret;
+	if (val < min || val > max)
+		return -EINVAL;
+
+	*frame_len = val;
+
+	if (!pinfo->enabled || pinfo->vrefresh != vrefresh)
+		return count;
+
+	pinfo->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	icna3520_set_frame_len(&dsi_ctx, pinfo);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9F, 0x0D);
+	pinfo->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return dsi_ctx.accum_err ?: count;
+}
+
+static ssize_t frame_len_120_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct panel_info *pinfo = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%u\n", pinfo->frame_len_120);
+}
+
+static ssize_t frame_len_120_store(struct device *dev,
+				   struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	struct panel_info *pinfo = dev_get_drvdata(dev);
+
+	return icna3520_frame_len_store(dev, &pinfo->frame_len_120, 120,
+					0x10, 0x80, buf, count);
+}
+static DEVICE_ATTR_RW(frame_len_120);
+
+static ssize_t frame_len_60_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct panel_info *pinfo = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%u\n", pinfo->frame_len_60);
+}
+
+static ssize_t frame_len_60_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct panel_info *pinfo = dev_get_drvdata(dev);
+
+	return icna3520_frame_len_store(dev, &pinfo->frame_len_60, 60,
+					0x770, 0x838, buf, count);
+}
+static DEVICE_ATTR_RW(frame_len_60);
+
+static struct attribute *icna3520_attrs[] = {
+	&dev_attr_frame_len_120.attr,
+	&dev_attr_frame_len_60.attr,
+	NULL
+};
+
+static const struct attribute_group icna3520_group = {
+	.attrs = icna3520_attrs,
+};
+
 static int icna35xx_probe(struct mipi_dsi_device *dsi)
 {
 	struct device *dev = &dsi->dev;
@@ -758,6 +865,14 @@ static int icna35xx_probe(struct mipi_dsi_device *dsi)
 	pinfo->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, pinfo);
 
+	if (pinfo->desc->frame_len_120) {
+		pinfo->frame_len_120 = pinfo->desc->frame_len_120;
+		pinfo->frame_len_60 = pinfo->desc->frame_len_60;
+		ret = devm_device_add_group(dev, &icna3520_group);
+		if (ret)
+			return ret;
+	}
+
 	ret = of_drm_get_panel_orientation(dev->of_node, &pinfo->orientation);
 	if (ret < 0) {
 		dev_err(dev, "%pOF: failed to get orientation %d\n", dev->of_node, ret);
