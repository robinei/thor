From: thor <thor@localhost>
Subject: [PATCH] arm64: dts: qcom: thor: the ADSP sensor hub for FastRPC

PB-OS's qcs8550-ayn-thor.append (project-barry/pb-os 8ea4653): the remote
heap, sensors-PD restart tracking and the stock process types of the
FastRPC context banks, for the motion sensors (with pbos-0560). Tested
on a Thor by PB-OS (faff51e).
---
diff --git a/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts b/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts
index d48c300df..7b08eab0e 100644
--- a/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts
+++ b/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts
@@ -489,3 +489,54 @@ &pm8550b_hv_haptics {
 	/delete-property/ qcom,use-erm;
 	qcom,vmax-mv = <1300>;
 };
+
+/*
+ * Motion sensors (SH5001 accelerometer and gyroscope) through the ADSP's
+ * sensor hub: a remote heap for the ADSP, sensors-PD restart tracking, and
+ * the process type of each FastRPC context bank as on the stock Thor, so
+ * hexagonrpcd's SensorsPD and RootPD listeners get the banks the stock
+ * ADSP expects (patch 0560). From MaSi's SteamOS-ARM-SM8550
+ * (qcs8550-ayn-gyro-fastrpc / -thor-gyro-fastrpc-pd).
+ */
+/ {
+	reserved-memory {
+		adsp_rpc_remote_heap_mem: adsp-rpc-remote-heap {
+			compatible = "shared-dma-pool";
+			alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
+			alignment = <0x0 0x400000>;
+			size = <0x0 0xc00000>;
+			reusable;
+		};
+	};
+};
+
+&remoteproc_adsp {
+	glink-edge {
+		fastrpc {
+			memory-region = <&adsp_rpc_remote_heap_mem>;
+			qcom,fastrpc-adsp-sensors-pdr;
+			qcom,vmids = <QCOM_SCM_VMID_LPASS QCOM_SCM_VMID_ADSP_HEAP>;
+
+			compute-cb@3 {
+				qcom,pd-type = <1>;
+			};
+
+			compute-cb@4 {
+				qcom,pd-type = <2>;
+			};
+
+			compute-cb@5 {
+				qcom,nsessions = <8>;
+				qcom,pd-type = <3>;
+			};
+
+			compute-cb@6 {
+				qcom,pd-type = <7>;
+			};
+
+			compute-cb@7 {
+				qcom,pd-type = <7>;
+			};
+		};
+	};
+};
